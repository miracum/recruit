<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <RootNamespace>list</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- list.Tests and fhir-constants-cs each live in a subdirectory of this project and are their
         own separate projects (see the ProjectReference below for the latter); without this, the
         SDK's default glob would compile their files directly into list.csproj too. -->
    <Compile Remove="list.Tests/**/*.cs" />
    <Content Remove="list.Tests/**" />
    <None Remove="list.Tests/**" />
    <Compile Remove="fhir-constants-cs/**/*.cs" />
    <Content Remove="fhir-constants-cs/**" />
    <None Remove="fhir-constants-cs/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="BlazorBlueprint.Components" Version="3.15.0" />
    <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Hl7.Fhir.R4" Version="6.4.0" />
    <PackageReference Include="HtmlSanitizer" Version="9.1.982" />
    <PackageReference Include="io.github.diz-uker.fhir-ig-constants" Version="0.2.14" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Markdig" Version="0.37.0" />
    <PackageReference
      Include="Microsoft.AspNetCore.Authentication.OpenIdConnect"
      Version="10.0.4"
    />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Mjml.Net" Version="4.14.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference
      Include="OpenTelemetry.Exporter.Prometheus.AspNetCore"
      Version="1.17.0-beta.1"
    />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageReference Include="ReverseMarkdown" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="fhir-constants-cs/fhir-constants-cs.csproj" />
  </ItemGroup>
</Project>
