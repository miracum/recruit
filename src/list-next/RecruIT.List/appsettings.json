{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "Host=localhost;Port=5432;Database=recruit;Username=postgres;Password=postgres"
  },
  "Fhir": {
    "BaseUrl": "http://localhost:8082/fhir"
  },
  "Auth": {
    "Disabled": false,
    "AdminRole": "admin"
  },
  "Oidc": {
    "Authority": "",
    "ClientId": "",
    "ClientSecret": "",
    "RoleClaimType": "role"
  },
  "Notifications": {
    "NewSuggestionWindowDays": 7,
    "ScanIntervalSeconds": 60
  },
  "Tracing": {
    "Enabled": false
  },
  "OTEL_SERVICE_NAME": "list-next",
  "NotifyMailer": {
    "ScreeningListLinkTemplate": "http://localhost:5237/trials/{0}/patients",
    "From": "recruit@example.com",
    "SubjectTemplate": "recruIT: neue Rekrutierungsvorschläge für die {0}-Studie",
    "SmtpHost": "localhost",
    "SmtpPort": 3025
  }
}
