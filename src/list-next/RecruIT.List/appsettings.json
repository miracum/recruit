{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "Host=localhost;Port=5432;Database=recruit;Username=postgres;Password=postgres"
  },
  "Fhir": {
    "BaseUrl": "http://localhost:8082/fhir"
  },
  "Auth": {
    "Disabled": false,
    "AdminRole": "admin"
  },
  "Oidc": {
    "Authority": "",
    "ClientId": "",
    "ClientSecret": "",
    "RoleClaimType": "role"
  },
  "Notifications": {
    "NewSuggestionWindowDays": 7,
    "ScanIntervalSeconds": 60
  },
  "NotifyMailer": {
    "ListSearchCriteria": "List?code=https://miracum.github.io/recruit/fhir/CodeSystem/screening-list-type|screening-recommendations",
    "ScreeningListLinkTemplate": "http://localhost:8080/recommendations/[list_id]",
    "From": "recruit@example.com",
    "SubjectTemplate": "MIRACUM Rekrutierungsunterstützung: neue Vorschläge für die Studie [study_acronym]",
    "SmtpHost": "localhost",
    "SmtpPort": 3025
  }
}
