@inject IStringLocalizer<SharedResources> Localizer

<BbPopover Open="_open" OpenChanged="@(open => _open = open)">
    <BbPopoverTrigger AsChild="true">
        <BbButton Variant="@(_subscribed ? ButtonVariant.Secondary : ButtonVariant.Outline)" Size="ButtonSize.Small"
                  Class="relative shrink-0" AriaLabel="@Localizer["App.Subscription.ButtonLabel"]">
            <Icon><LucideIcon Name="bell" Size="16" /></Icon>
            <ChildContent>
                @if (_subscribed)
                {
                    <span class="pointer-events-none absolute top-0.5 right-0.5 h-2 w-2 rounded-full bg-primary ring-2 ring-background" aria-hidden="true"></span>
                }
            </ChildContent>
        </BbButton>
    </BbPopoverTrigger>
    <BbPopoverContent Side="PopoverSide.Bottom" Align="PopoverAlign.End" Class="w-80">
        <div class="space-y-4">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <p class="text-sm font-medium">@Localizer["App.Subscription.PopoverTitle"]</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@Localizer["App.Subscription.PopoverDescription"]</p>
                </div>
                <BbSwitch Checked="_subscribed" CheckedChanged="@(v => _subscribed = v)" AriaLabel="@Localizer["App.Subscription.ButtonLabel"]" Class="mt-0.5 shrink-0" />
            </div>

            @if (_subscribed)
            {
                <BbSeparator />

                <div>
                    <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.Subscription.FrequencyLabel"]</span>
                    <BbRadioGroup TValue="NotificationFrequency" Value="_frequency" ValueChanged="@(v => _frequency = v)" Class="mt-2 flex flex-col gap-2">
                        <BbRadioGroupItem TValue="NotificationFrequency" Value="NotificationFrequency.Instant" Label="@Localizer["App.Subscription.FrequencyInstant"]" />
                        <BbRadioGroupItem TValue="NotificationFrequency" Value="NotificationFrequency.Daily" Label="@Localizer["App.Subscription.FrequencyDaily"]" />
                        <BbRadioGroupItem TValue="NotificationFrequency" Value="NotificationFrequency.Weekly" Label="@Localizer["App.Subscription.FrequencyWeekly"]" />
                        <BbRadioGroupItem TValue="NotificationFrequency" Value="NotificationFrequency.Monthly" Label="@Localizer["App.Subscription.FrequencyMonthly"]" />
                    </BbRadioGroup>
                </div>

                @if (_frequency != NotificationFrequency.Instant)
                {
                    <div class="grid grid-cols-2 gap-3">
                        @if (_frequency == NotificationFrequency.Weekly)
                        {
                            <div>
                                <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.Subscription.DayOfWeekLabel"]</label>
                                <select class="mt-1 block w-full rounded-md border bg-background p-2 text-sm" @bind="_dayOfWeek">
                                    @foreach (var day in DayOfWeekOptions)
                                    {
                                        <option value="@day">@Localizer[DayOfWeekKey(day)]</option>
                                    }
                                </select>
                            </div>
                        }
                        else if (_frequency == NotificationFrequency.Monthly)
                        {
                            <div>
                                <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.Subscription.DayOfMonthLabel"]</label>
                                <select class="mt-1 block w-full rounded-md border bg-background p-2 text-sm" @bind="_dayOfMonth">
                                    @foreach (var day in DayOfMonthOptions)
                                    {
                                        <option value="@day">@day</option>
                                    }
                                </select>
                            </div>
                        }
                        <div>
                            <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.Subscription.TimeLabel"]</label>
                            <BbInput Type="InputType.Time" @bind-Value="_time" Class="mt-1" />
                        </div>
                    </div>
                }
            }

            <div class="flex justify-end pt-1">
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => _open = false)">
                    @Localizer["App.Subscription.DoneButton"]
                </BbButton>
            </div>
        </div>
    </BbPopoverContent>
</BbPopover>

@code {
    private static readonly DayOfWeek[] DayOfWeekOptions =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday,
    ];

    private static readonly int[] DayOfMonthOptions = [.. Enumerable.Range(1, 31)];

    private bool _open;
    private bool _subscribed;
    private NotificationFrequency _frequency = NotificationFrequency.Instant;
    private DayOfWeek _dayOfWeek = DayOfWeek.Monday;
    private int _dayOfMonth = 1;
    private string _time = "09:00";

    private static string DayOfWeekKey(DayOfWeek day) =>
        day switch
        {
            DayOfWeek.Monday => "App.Subscription.DayMonday",
            DayOfWeek.Tuesday => "App.Subscription.DayTuesday",
            DayOfWeek.Wednesday => "App.Subscription.DayWednesday",
            DayOfWeek.Thursday => "App.Subscription.DayThursday",
            DayOfWeek.Friday => "App.Subscription.DayFriday",
            DayOfWeek.Saturday => "App.Subscription.DaySaturday",
            _ => "App.Subscription.DaySunday",
        };
}
