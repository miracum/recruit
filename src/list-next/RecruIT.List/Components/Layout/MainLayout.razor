@using System.Reflection
@inherits LayoutComponentBase
@implements IDisposable
@inject BreadcrumbState BreadcrumbState
@inject ScreeningListService ScreeningListService
@inject IStringLocalizer<SharedResources> Localizer
@inject NavigationManager Navigation
@inject ThemeService ThemeService

<BbSidebarProvider CookieKey="@((string?)null)">
    <BbSidebar Collapsible="false">
        <BbSidebarHeader>
            <div class="flex h-12 items-center gap-2 px-3">
                <div class="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-primary-foreground">
                    <LucideIcon Name="clipboard-list" Size="16" />
                </div>
                <span class="text-sm font-semibold">recruIT</span>
            </div>
        </BbSidebarHeader>
        <BbSidebarContent Class="flex-1 overflow-auto px-2">
            <BbSidebarGroup>
                <BbSidebarMenu>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/" Match="NavLinkMatch.All">
                            <LucideIcon Name="flask-conical" Size="16" />
                            @Localizer["App.Nav.Trials"]
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/patients">
                            <LucideIcon Name="users" Size="16" />
                            @Localizer["App.Nav.Patients"]
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/notifications">
                            <LucideIcon Name="bell" Size="16" />
                            @Localizer["App.Nav.Notifications"]
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <AuthorizeView Roles="@TrialAccessService.AdminRole">
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/admin/criteria">
                                <LucideIcon Name="list-checks" Size="16" />
                                @Localizer["App.Nav.CriteriaManager"]
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/hangfire" target="_blank" rel="noopener noreferrer">
                                <LucideIcon Name="activity" Size="16" />
                                @Localizer["App.Nav.HangfireDashboard"]
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </AuthorizeView>
                </BbSidebarMenu>
            </BbSidebarGroup>
        </BbSidebarContent>
        <BbSidebarFooter>
            <div class="px-3 py-2 text-xs text-muted-foreground">
                <BbTooltip Placement="PopoverPlacement.Top">
                    <BbTooltipTrigger AsChild="false">
                        <span>@AppVersionShort</span>
                    </BbTooltipTrigger>
                    <BbTooltipContent>@AppVersion</BbTooltipContent>
                </BbTooltip>
            </div>
        </BbSidebarFooter>
    </BbSidebar>

    <BbSidebarInset Class="flex min-w-0 flex-col bg-background">
        <header class="flex shrink-0 items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <BbSidebarTrigger Class="h-8 w-8 md:hidden">
                    <LucideIcon Name="menu" Size="16" />
                </BbSidebarTrigger>
                <Breadcrumbs Items="BreadcrumbState.Items" />
            </div>
            <div class="flex items-center gap-2">
                <button type="button" @onclick="ToggleTheme"
                        class="rounded p-1 hover:bg-accent hover:text-accent-foreground"
                        aria-label="@(ThemeService.IsDarkMode ? Localizer["App.Theme.SwitchToLight"] : Localizer["App.Theme.SwitchToDark"])">
                    <LucideIcon Name="@(ThemeService.IsDarkMode ? "sun" : "moon")" Size="16" />
                </button>
                <div class="flex items-center gap-1 text-xs text-muted-foreground">
                    @for (var i = 0; i < SupportedCultures.Length; i++)
                    {
                        var culture = SupportedCultures[i];
                        <a href="@BuildCultureUrl(culture)" data-enhance-nav="false"
                           class="rounded px-1.5 py-0.5 uppercase hover:bg-accent hover:text-accent-foreground @(IsCurrentCulture(culture) ? "font-semibold text-foreground" : "")">
                            @culture
                        </a>
                        @if (i < SupportedCultures.Length - 1)
                        {
                            <span aria-hidden="true">|</span>
                        }
                    }
                </div>
                <AuthorizeView>
                    <Authorized>
                        <BbDropdownMenu>
                            <BbDropdownMenuTrigger AsChild="false" Class="flex items-center gap-2 rounded-md p-1 hover:bg-accent hover:text-accent-foreground">
                                <BbAvatar Size="AvatarSize.Small">
                                    <BbAvatarFallback>@GetInitials(context.User)</BbAvatarFallback>
                                </BbAvatar>
                            </BbDropdownMenuTrigger>
                            <BbDropdownMenuContent Side="PopoverSide.Bottom" Align="PopoverAlign.End" Class="w-64">
                                <BbDropdownMenuLabel>
                                    <div class="flex flex-col">
                                        <span class="truncate text-sm font-medium">@GetFullName(context.User)</span>
                                        <span class="truncate text-xs font-normal text-muted-foreground">@GetEmail(context.User)</span>
                                    </div>
                                </BbDropdownMenuLabel>
                                <BbDropdownMenuSeparator />
                                <BbDropdownMenuLabel Class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                                    @Localizer["App.User.Roles"]
                                </BbDropdownMenuLabel>
                                <div class="px-2 pb-2">
                                    @{
                                        var roles = GetRoles(context.User);
                                    }
                                    @if (roles.Count == 0)
                                    {
                                        <span class="text-xs text-muted-foreground">@Localizer["App.User.NoRoles"]</span>
                                    }
                                    else
                                    {
                                        <div class="flex flex-wrap gap-1">
                                            @foreach (var role in roles)
                                            {
                                                <BbBadge Variant="BadgeVariant.Secondary">@role</BbBadge>
                                            }
                                        </div>
                                    }
                                </div>
                                <BbDropdownMenuSeparator />
                                <BbDropdownMenuItem OnClick="SignOut">
                                    <Icon><LucideIcon Name="log-out" Size="16" /></Icon>
                                    <ChildContent>@Localizer["App.Nav.SignOut"]</ChildContent>
                                </BbDropdownMenuItem>
                            </BbDropdownMenuContent>
                        </BbDropdownMenu>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/authentication/login" class="text-sm">@Localizer["App.Nav.SignIn"]</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>
        <main class="min-h-0 flex-1 overflow-auto p-4">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertTitle>@Localizer["App.ErrorBoundary.Title"]</BbAlertTitle>
                        <BbAlertDescription>
                            @Localizer["App.ErrorBoundary.Description"]
                        </BbAlertDescription>
                    </BbAlert>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </BbSidebarInset>
</BbSidebarProvider>

<BbPortalHost />
<BbToastProvider />

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["App.BlazorError.Message"]
    <a href="." class="reload">@Localizer["App.BlazorError.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] SupportedCultures = ["de", "en"];

    private static readonly string AppVersion =
        Assembly.GetExecutingAssembly().GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
        ?? Assembly.GetExecutingAssembly().GetName().Version?.ToString()
        ?? "unknown";

    private static readonly string AppVersionShort = AppVersion.Split('+')[0];

    private static readonly string[] DotColors =
    [
        "bg-blue-500", "bg-green-500", "bg-orange-500", "bg-purple-500", "bg-pink-500", "bg-teal-500",
    ];

    private List<TrialSummaryDto> _trials = [];
    private string _trialSearch = string.Empty;

    private List<TrialSummaryDto> FilteredActiveTrials =>
        [.. _trials.Where(t => t.ListStatus == "current" && MatchesSearch(t))];

    private List<TrialSummaryDto> FilteredInactiveTrials =>
        [.. _trials.Where(t => t.ListStatus != "current" && MatchesSearch(t))];

    private bool MatchesSearch(TrialSummaryDto trial) =>
        string.IsNullOrWhiteSpace(_trialSearch) || trial.StudyAcronym.Contains(_trialSearch, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        BreadcrumbState.Changed += OnBreadcrumbChanged;

        try
        {
            var user = AuthStateTask is not null ? (await AuthStateTask).User : new ClaimsPrincipal();
            _trials = [.. await ScreeningListService.GetAccessibleTrialsAsync(user)];
        }
        catch
        {
            // The sidebar trial list is a navigation convenience, not the source of truth - if it
            // fails to load, pages that actually need trial data (Dashboard, PatientList) surface
            // their own error there. Just leave the sidebar list empty.
            _trials = [];
        }
    }

    private static string TrialDotColor(string acronym) =>
        DotColors[Math.Abs(acronym.GetHashCode()) % DotColors.Length];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // JS interop (localStorage/system-preference detection) isn't available during the
            // static prerender pass, only once the interactive circuit is attached - hence here
            // rather than OnInitializedAsync.
            await ThemeService.InitializeAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleDarkModeAsync();
        StateHasChanged();
    }

    private bool IsCurrentCulture(string culture) =>
        string.Equals(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, culture, StringComparison.OrdinalIgnoreCase);

    private string BuildCultureUrl(string culture)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var redirectUri = Uri.EscapeDataString(string.IsNullOrEmpty(relativePath) ? "/" : $"/{relativePath}");
        return $"/culture/set?culture={culture}&redirectUri={redirectUri}";
    }

    private void OnBreadcrumbChanged() => InvokeAsync(StateHasChanged);

    // forceLoad is required: a Blazor Server circuit has no HTTP response of its own to attach a
    // Set-Cookie header to, so signing out has to happen via a real navigation to the endpoint
    // that calls SignOutAsync (see Program.cs's /authentication/logout).
    private void SignOut() => Navigation.NavigateTo("/authentication/logout", forceLoad: true);

    private static string GetFullName(ClaimsPrincipal user) => user.GetDisplayName() ?? string.Empty;

    private static string GetEmail(ClaimsPrincipal user) =>
        user.FindFirst("email")?.Value
        ?? user.FindFirst(ClaimTypes.Email)?.Value
        ?? string.Empty;

    private static List<string> GetRoles(ClaimsPrincipal user)
    {
        var roleClaimType = (user.Identity as ClaimsIdentity)?.RoleClaimType ?? ClaimTypes.Role;
        return [.. user.Claims.Where(c => c.Type == roleClaimType).Select(c => c.Value).Distinct()];
    }

    private static string GetInitials(ClaimsPrincipal user)
    {
        var source = GetFullName(user);
        if (string.IsNullOrWhiteSpace(source))
        {
            return "?";
        }

        var parts = source.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
        };
    }

    public void Dispose() => BreadcrumbState.Changed -= OnBreadcrumbChanged;
}
