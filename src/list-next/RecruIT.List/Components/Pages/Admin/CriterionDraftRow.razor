@inject IStringLocalizer<SharedResources> Localizer

<div class="rounded-md border p-3">
    <div class="flex flex-wrap items-start justify-between gap-2">
        <div class="min-w-48 flex-1">
            <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.CriteriaManager.CriterionDisplayTextLabel"]</label>
            @if (IsFromLibrary)
            {
                <p class="mt-1 text-sm">@Criterion.DisplayText</p>
            }
            else
            {
                <BbInput @bind-Value="Criterion.DisplayText" Class="mt-1" />
            }
        </div>
        <div class="flex flex-wrap items-center gap-1">
            @if (IsFromLibrary)
            {
                <BbBadge Variant="BadgeVariant.Secondary">@Localizer["App.CriteriaManager.FromLibraryBadge"]</BbBadge>
            }
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="!CanMoveUp"
                      OnClick="OnMoveUp" title="@Localizer["App.CriteriaManager.MoveUpButton"]">
                <LucideIcon Name="chevron-up" Size="14" />
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="!CanMoveDown"
                      OnClick="OnMoveDown" title="@Localizer["App.CriteriaManager.MoveDownButton"]">
                <LucideIcon Name="chevron-down" Size="14" />
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="OnMoveToOtherColumn">
                @(Criterion.Exclude
                    ? Localizer["App.CriteriaManager.MoveToInclusionButton"]
                    : Localizer["App.CriteriaManager.MoveToExclusionButton"])
            </BbButton>
            <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" OnClick="OnRemove">
                @Localizer["App.CriteriaManager.RemoveCriterionButton"]
            </BbButton>
        </div>
    </div>

    @if (IsFromLibrary)
    {
        @if (!string.IsNullOrWhiteSpace(Criterion.Sql))
        {
            <details class="mt-3">
                <summary class="cursor-pointer text-xs font-medium uppercase tracking-wide text-muted-foreground hover:text-foreground">
                    @Localizer["App.CriteriaManager.CriterionSqlLabel"]
                </summary>
                <pre class="mt-2 max-h-64 overflow-auto rounded-md border bg-muted p-3 text-xs"><code>@Criterion.Sql</code></pre>
            </details>
        }
    }
    else
    {
        <div class="mt-3">
            <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.CriteriaManager.CriterionSqlLabel"]</label>
            <textarea class="mt-1 block w-full rounded-md border bg-background p-2 font-mono text-xs" rows="4"
                      @bind="Criterion.Sql" @bind:event="oninput"></textarea>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required CriterionDraft Criterion { get; set; }

    [Parameter]
    public bool CanMoveUp { get; set; }

    [Parameter]
    public bool CanMoveDown { get; set; }

    [Parameter]
    public EventCallback OnMoveUp { get; set; }

    [Parameter]
    public EventCallback OnMoveDown { get; set; }

    [Parameter]
    public EventCallback OnMoveToOtherColumn { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    /// <summary>Library-backed criteria show their (read-only) source SQL; ad hoc ones are edited inline.</summary>
    private bool IsFromLibrary => !string.IsNullOrWhiteSpace(Criterion.ExistingLibraryReference);
}
