@page "/admin/criteria"
@attribute [Authorize]
@inject EligibilityCriteriaService CriteriaService
@inject BreadcrumbState BreadcrumbState
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["App.CriteriaManager.PageTitle"]</PageTitle>

@if (!_isAdmin)
{
    <BbAlert Variant="AlertVariant.Danger">
        <BbAlertDescription>@Localizer["App.Errors.NotAuthorizedAdminOnly"]</BbAlertDescription>
    </BbAlert>
}
else
{
    <BbCard>
        <BbCardHeader>
            <BbCardTitle>@Localizer["App.CriteriaManager.LibrarySectionTitle"]</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            <p class="mb-3 text-sm text-muted-foreground">@Localizer["App.CriteriaManager.LibrarySectionDescription"]</p>

            @if (_librariesLoading)
            {
                <BbSkeleton Class="h-24 w-full" />
            }
            else if (_libraryLoadErrorMessage is not null)
            {
                <BbAlert Variant="AlertVariant.Danger">
                    <BbAlertDescription>@_libraryLoadErrorMessage</BbAlertDescription>
                </BbAlert>
            }
            else
            {
                <BbInput @bind-Value="_librarySearch" @bind:event="oninput"
                         Placeholder="@Localizer["App.CriteriaManager.LibrarySearchPlaceholder"]" Class="mb-4 max-w-sm" />

                @if (FilteredLibraries.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">@Localizer["App.CriteriaManager.NoLibrariesMessage"]</p>
                }
                else
                {
                    <div class="flex flex-col gap-4">
                        @foreach (var library in FilteredLibraries)
                        {
                            <div class="rounded-md border p-3">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <div>
                                        <div class="font-medium">@(library.Title ?? library.Id)</div>
                                        @if (!string.IsNullOrWhiteSpace(library.Name))
                                        {
                                            <div class="text-xs text-muted-foreground">@library.Name</div>
                                        }
                                    </div>
                                    <div class="flex flex-col items-end gap-1">
                                        @if (library.Status is not null)
                                        {
                                            <BbBadge Variant="BadgeVariant.Secondary">@library.Status</BbBadge>
                                        }
                                        @if (library.LastUpdated is not null)
                                        {
                                            <span class="text-xs text-muted-foreground">
                                                @Localizer["App.CriteriaManager.LastUpdatedLabel"]: @library.LastUpdated.Value.LocalDateTime.ToString("g")
                                            </span>
                                        }
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(library.Description))
                                {
                                    <p class="mt-1 text-sm text-muted-foreground">@library.Description</p>
                                }
                                <div class="mt-2 flex flex-wrap items-center gap-1 text-xs text-muted-foreground">
                                    <span>@(Localizer["App.CriteriaManager.LibraryUsedByLabel"]):</span>
                                    @if (library.UsedByStudyDisplayNames.Count == 0)
                                    {
                                        <span>@Localizer["App.CriteriaManager.LibraryNotUsedLabel"]</span>
                                    }
                                    else
                                    {
                                        @foreach (var studyName in library.UsedByStudyDisplayNames)
                                        {
                                            <BbBadge Variant="BadgeVariant.Outline">@studyName</BbBadge>
                                        }
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(library.Sql))
                                {
                                    <details class="mt-3">
                                        <summary class="cursor-pointer text-xs font-medium uppercase tracking-wide text-muted-foreground hover:text-foreground">
                                            @Localizer["App.CriteriaManager.CriterionSqlLabel"]
                                        </summary>
                                        <pre class="mt-2 max-h-64 overflow-auto rounded-md border bg-muted p-3 text-xs"><code>@library.Sql</code></pre>
                                    </details>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </BbCardContent>
    </BbCard>

    <BbCard Class="mt-6">
        <BbCardHeader>
            <BbCardTitle>@Localizer["App.CriteriaManager.StudySectionTitle"]</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            <div class="flex gap-2">
                <BbButton Variant="@(_studyMode == StudyMode.Existing ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Small" OnClick="@(() => _studyMode = StudyMode.Existing)">
                    @Localizer["App.CriteriaManager.ExistingStudyTab"]
                </BbButton>
                <BbButton Variant="@(_studyMode == StudyMode.New ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Small" OnClick="@(() => _studyMode = StudyMode.New)">
                    @Localizer["App.CriteriaManager.NewStudyTab"]
                </BbButton>
            </div>

            @if (_studyMode == StudyMode.Existing)
            {
                <div class="mt-4 max-w-md">
                    @if (_existingStudiesLoading)
                    {
                        <BbSkeleton Class="h-9 w-full" />
                    }
                    else if (_studyLoadErrorMessage is not null)
                    {
                        <BbAlert Variant="AlertVariant.Danger">
                            <BbAlertDescription>@_studyLoadErrorMessage</BbAlertDescription>
                        </BbAlert>
                    }
                    else if (_existingStudies.Count == 0)
                    {
                        <p class="text-sm text-muted-foreground">@Localizer["App.CriteriaManager.NoExistingStudies"]</p>
                    }
                    else
                    {
                        <select class="block w-full rounded-md border bg-background p-2 text-sm"
                                @bind="_selectedExistingStudyId" @bind:after="OnExistingStudySelected">
                            <option value="">@Localizer["App.CriteriaManager.SelectStudyPlaceholder"]</option>
                            @foreach (var study in _existingStudies)
                            {
                                <option value="@study.Id">@(study.Acronym ?? study.Title ?? study.Id)</option>
                            }
                        </select>
                    }
                </div>
            }

            <div class="mt-4 flex flex-wrap gap-3">
                <div class="min-w-64 flex-1">
                    <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.CriteriaManager.StudyTitleLabel"]</label>
                    <BbInput @bind-Value="_studyDraft.Title" Disabled="@(_studyMode == StudyMode.Existing)" Class="mt-1" />
                </div>
                <div class="w-full max-w-xs">
                    <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.CriteriaManager.StudyAcronymLabel"]</label>
                    <BbInput @bind-Value="_studyDraft.Acronym" Disabled="@(_studyMode == StudyMode.Existing)" Class="mt-1" />
                </div>
                <div class="w-full max-w-sm">
                    <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.CriteriaManager.IdentifierSystemLabel"]</label>
                    <BbInput @bind-Value="_studyDraft.IdentifierSystem" Disabled="@(_studyMode == StudyMode.Existing)" Class="mt-1" />
                </div>
                <div class="w-full max-w-xs">
                    <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.CriteriaManager.IdentifierValueLabel"]</label>
                    <BbInput @bind-Value="_studyDraft.IdentifierValue" Disabled="@(_studyMode == StudyMode.Existing)" Class="mt-1" />
                </div>
            </div>
        </BbCardContent>
    </BbCard>

    <BbCard Class="mt-6">
        <BbCardHeader>
            <BbCardTitle>@Localizer["App.CriteriaManager.CriteriaSectionTitle"]</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            @if (_criteria.Count == 0)
            {
                <p class="text-sm text-muted-foreground">@Localizer["App.CriteriaManager.NoCriteriaMessage"]</p>
            }
            else
            {
                <div class="flex flex-col gap-4">
                    @foreach (var criterion in _criteria)
                    {
                        <div class="rounded-md border p-3">
                            <div class="flex flex-wrap items-end gap-3">
                                <div class="min-w-64 flex-1">
                                    <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.CriteriaManager.CriterionDisplayTextLabel"]</label>
                                    <BbInput @bind-Value="criterion.DisplayText" Class="mt-1" />
                                </div>
                                <div>
                                    <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.CriteriaManager.CriterionTypeLabel"]</label>
                                    <select class="mt-1 block rounded-md border bg-background p-2 text-sm" @bind="criterion.Exclude">
                                        <option value="false">@Localizer["App.CriteriaManager.InclusionOption"]</option>
                                        <option value="true">@Localizer["App.CriteriaManager.ExclusionOption"]</option>
                                    </select>
                                </div>
                                <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" OnClick="@(() => RemoveCriterion(criterion))">
                                    @Localizer["App.CriteriaManager.RemoveCriterionButton"]
                                </BbButton>
                            </div>
                            <div class="mt-3">
                                <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.CriteriaManager.CriterionExistingLibraryLabel"]</label>
                                <BbInput @bind-Value="criterion.ExistingLibraryReference" Placeholder="Library/common-age-min-18" Class="mt-1" />
                            </div>
                            @if (string.IsNullOrWhiteSpace(criterion.ExistingLibraryReference))
                            {
                                <div class="mt-3">
                                    <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.CriteriaManager.CriterionSqlLabel"]</label>
                                    <textarea class="mt-1 block w-full rounded-md border bg-background p-2 font-mono text-xs" rows="4"
                                              @bind="criterion.Sql" @bind:event="oninput"></textarea>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            <BbButton Variant="ButtonVariant.Outline" Class="mt-4" OnClick="AddCriterion">
                <Icon><LucideIcon Name="plus" Size="16" /></Icon>
                <ChildContent>@Localizer["App.CriteriaManager.AddCriterionButton"]</ChildContent>
            </BbButton>
        </BbCardContent>
    </BbCard>

    <BbCard Class="mt-6">
        <BbCardHeader>
            <BbCardTitle>@Localizer["App.CriteriaManager.PreviewSectionTitle"]</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            <p class="mb-3 text-sm text-muted-foreground">@Localizer["App.CriteriaManager.PreviewDescription"]</p>
            <pre class="max-h-[32rem] overflow-auto rounded-md border bg-muted p-3 text-xs"><code>@PreviewJson</code></pre>
        </BbCardContent>
    </BbCard>
}

@code {
    private enum StudyMode
    {
        New,
        Existing,
    }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _isAdmin;
    private ClaimsPrincipal _user = new();

    private StudyMode _studyMode = StudyMode.New;
    private ResearchStudyDraft _studyDraft = new();
    private readonly List<CriterionDraft> _criteria = [];

    private List<ResearchStudySummaryDto> _existingStudies = [];
    private bool _existingStudiesLoading = true;
    private string _selectedExistingStudyId = string.Empty;
    private string? _studyLoadErrorMessage;

    private List<LibrarySummaryDto> _libraries = [];
    private bool _librariesLoading = true;
    private string _librarySearch = string.Empty;
    private string? _libraryLoadErrorMessage;

    private string PreviewJson => CriteriaService.BuildPreviewJson(_studyDraft, _criteria);

    private List<LibrarySummaryDto> FilteredLibraries =>
        [.. _libraries.Where(MatchesLibrarySearch)];

    private bool MatchesLibrarySearch(LibrarySummaryDto library) =>
        string.IsNullOrWhiteSpace(_librarySearch)
        || (library.Title?.Contains(_librarySearch, StringComparison.OrdinalIgnoreCase) ?? false)
        || library.Id.Contains(_librarySearch, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _user = AuthStateTask is not null ? (await AuthStateTask).User : new ClaimsPrincipal();
        _isAdmin = TrialAccessService.IsAdmin(_user);

        BreadcrumbState.Set(
            new BreadcrumbItem(Localizer["App.Common.AllTrialsBreadcrumb"], "/"),
            new BreadcrumbItem(Localizer["App.CriteriaManager.Breadcrumb"]));

        if (!_isAdmin)
        {
            return;
        }

        try
        {
            _libraries = [.. await CriteriaService.SearchLibrariesAsync()];
        }
        catch (Exception ex)
        {
            _libraryLoadErrorMessage = ex.Message;
        }
        finally
        {
            _librariesLoading = false;
        }

        try
        {
            _existingStudies = [.. await CriteriaService.SearchResearchStudiesAsync()];
        }
        catch (Exception ex)
        {
            _studyLoadErrorMessage = ex.Message;
        }
        finally
        {
            _existingStudiesLoading = false;
        }
    }

    private void OnExistingStudySelected()
    {
        var study = _existingStudies.FirstOrDefault(s => s.Id == _selectedExistingStudyId);
        _studyDraft = study is null
            ? new ResearchStudyDraft()
            : new ResearchStudyDraft
            {
                ExistingId = study.Id,
                Title = study.Title ?? string.Empty,
                Acronym = study.Acronym ?? string.Empty,
                IdentifierSystem = study.TrialIdentifier?.System ?? string.Empty,
                IdentifierValue = study.TrialIdentifier?.Value ?? string.Empty,
            };
    }

    private void AddCriterion() => _criteria.Add(new CriterionDraft());

    private void RemoveCriterion(CriterionDraft criterion) => _criteria.Remove(criterion);
}
