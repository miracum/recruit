<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all padding="0px"></mj-all>

      <mj-text font-family="Ubuntu, Helvetica, Arial, sans-serif" padding="0 25px" font-size="13px"></mj-text>
      <mj-section background-color="#EFF6EE"></mj-section>
      <mj-class name="preheader" color="#000000" font-size="11px"></mj-class>
    </mj-attributes>
    <mj-style inline="inline">a { text-decoration: none!important; }</mj-style>
  </mj-head>
  <mj-body background-color="#bedae6">
    <mj-section>
      <mj-column width="100%">

         <mj-text align="center" padding="10px 25px" font-size="20px" color="#1C448E"><strong>recruIT</strong></mj-text>

      </mj-column>
    </mj-section>
    <mj-section padding-bottom="20px" padding-top="10px">
      <mj-column>

        <mj-text align="center" padding="10px 25px" font-size="20px" color="#242423"><strong>Hallo,</strong></mj-text>

        <mj-text align="center" font-size="16px" color="#242423" font-family="Ubuntu, Helvetica, Arial, sans-serif">Es wurden {{ NumNewSubjects }} mögliche neue Rekrutierungsvorschläge für die {{ StudyAcronym }}-Studie gefunden.</mj-text>

        <mj-button background-color="#1C448E" color="#EFF6EE" href="{{ ScreeningListLink }}" font-family="Ubuntu, Helvetica, Arial, sans-serif" padding="20px 0 0 0" font-weight="bold" font-size="16px">Screeningliste öffnen</mj-button>

      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
