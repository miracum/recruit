{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "Host=localhost;Port=5433;Database=list;Username=list;Password=list"
  },
  "Fhir": {
    "BaseUrl": "http://localhost:8082/fhir"
  },
  "Auth": {
    "Disabled": false
  },
  "Oidc": {
    "Authority": "",
    "ClientId": "",
    "ClientSecret": "",
    "RoleClaimType": "role"
  },
  "Notifications": {
    "NewSuggestionWindowDays": 7,
    "ScanIntervalSeconds": 60
  },
  "NotifyMailer": {
    "ListSearchCriteria": "List?code=https://fhir.miracum.org/uc1/CodeSystem/screeningList|screening-recommendations",
    "ScreeningListLinkTemplate": "http://localhost:8080/recommendations/[list_id]",
    "From": "recruit@example.com",
    "SubjectTemplate": "MIRACUM Rekrutierungsunterstützung: neue Vorschläge für die Studie [study_acronym]",
    "SmtpHost": "localhost",
    "SmtpPort": 3025
  }
}
