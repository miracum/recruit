<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!--
      RecruIT.List marks Microsoft.EntityFrameworkCore.Design PrivateAssets="all" (design-time
      tooling, deliberately not shipped in the published app) - so this ProjectReference doesn't
      inherit the EntityFrameworkCore.Relational floor that pulled in transitively, and this
      project's own restore would otherwise resolve a lower Relational version than RecruIT.List
      actually compiled against, breaking assembly loading at runtime. Pin it explicitly.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright.Xunit.v3" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RecruIT.List\RecruIT.List.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
