@page "/trials/{ListId}/patients/{ResearchSubjectId}"
@attribute [Authorize]
@inject ScreeningListService ScreeningListService
@inject ResearchSubjectService ResearchSubjectService
@inject PatientRecordService PatientRecordService
@inject ToastService Toast
@inject BreadcrumbState BreadcrumbState
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@(_entry?.Name ?? Localizer["App.PatientDetail.PageTitleFallback"])</PageTitle>

@if (_loading)
{
    <BbSkeleton Class="mb-4 h-8 w-64" />
    <BbSkeleton Class="h-64 w-full" />
}
else if (_errorMessage is not null)
{
    <BbAlert Variant="AlertVariant.Danger">
        <BbAlertTitle>@Localizer["App.PatientDetail.LoadErrorTitle"]</BbAlertTitle>
        <BbAlertDescription>@_errorMessage</BbAlertDescription>
    </BbAlert>
}
else if (_entry is not null)
{
    <p class="mb-4 text-sm text-muted-foreground">
        @(_entry.Age is not null ? Localizer["App.PatientDetail.AgeYearsOld", _entry.Age] : Localizer["App.Common.AgeUnknown"]), @(_entry.Gender is not null ? Localizer[GenderDisplay.GetKey(_entry.Gender)].Value : Localizer["App.Common.GenderUnknown"].Value)
        @if (_mrNumber is not null)
        {
            <span> &middot; MR @_mrNumber</span>
        }
    </p>

    <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.Patient.RecruitmentStatus"]</BbCardTitle>
            </BbCardHeader>
            <BbCardContent>
                <div class="flex flex-wrap gap-x-6 gap-y-3">
                    @foreach (var status in StatusOptions)
                    {
                        <label class="flex cursor-pointer items-center gap-2 text-sm">
                            <input type="radio" name="recruitment-status-detail" value="@status" checked="@(_entry.Status == status)"
                                   @onchange="() => OnStatusChanged(status)" class="h-4 w-4" style="accent-color: var(--primary);" />
                            @Localizer[StatusDisplay.GetKey(status)]
                        </label>
                    }
                </div>
                <p class="mt-3 text-sm text-muted-foreground">
                    @Localizer["App.PatientDetail.LastKnownLocationLabel", _location?.LocationName ?? Localizer["App.Common.Unknown"].Value]
                </p>
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardContent Class="pt-6">
                <PatientNotesSection Patient="_entry" StudyAcronym="@_trial!.StudyAcronym" />
            </BbCardContent>
        </BbCard>
    </div>

    @if (_history.Count > 0)
    {
        <section class="mb-6">
            <h2 class="mb-3 text-lg font-medium">@Localizer["App.PatientDetail.StatusHistoryTitle"]</h2>
            <BbTimeline>
                @foreach (var entry in _history)
                {
                    <BbTimelineItem Title="@Localizer[StatusDisplay.GetKey(entry.Status)]" Time="@entry.LastUpdated.LocalDateTime.ToString("g")" />
                }
            </BbTimeline>
        </section>
    }

    <section>
        <h2 class="mb-3 text-lg font-medium">@Localizer["App.PatientDetail.ClinicalSummaryTitle"]</h2>
        <BbTabs DefaultValue="conditions">
            <BbTabsList>
                <BbTabsTrigger Value="conditions">@Localizer["App.PatientDetail.TabConditions", _summary.Conditions.Count]</BbTabsTrigger>
                <BbTabsTrigger Value="procedures">@Localizer["App.PatientDetail.TabProcedures", _summary.Procedures.Count]</BbTabsTrigger>
                <BbTabsTrigger Value="medications">@Localizer["App.PatientDetail.TabMedications", _summary.MedicationStatements.Count + _summary.MedicationAdministrations.Count]</BbTabsTrigger>
                <BbTabsTrigger Value="observations">@Localizer["App.PatientDetail.TabObservations", _summary.Observations.Count]</BbTabsTrigger>
            </BbTabsList>
            <BbTabsContent Value="conditions">
                @if (_summary.Conditions.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">@Localizer["App.PatientDetail.NoConditions"]</p>
                }
                else
                {
                    <ul class="list-disc space-y-1 pl-5">
                        @foreach (var c in _summary.Conditions)
                        {
                            <li>@(c.Code?.Text ?? c.Code?.Coding?.FirstOrDefault()?.Display ?? Localizer["App.PatientDetail.UnspecifiedCondition"].Value)</li>
                        }
                    </ul>
                }
            </BbTabsContent>
            <BbTabsContent Value="procedures">
                @if (_summary.Procedures.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">@Localizer["App.PatientDetail.NoProcedures"]</p>
                }
                else
                {
                    <ul class="list-disc space-y-1 pl-5">
                        @foreach (var p in _summary.Procedures)
                        {
                            <li>@(p.Code?.Text ?? p.Code?.Coding?.FirstOrDefault()?.Display ?? Localizer["App.PatientDetail.UnspecifiedProcedure"].Value)</li>
                        }
                    </ul>
                }
            </BbTabsContent>
            <BbTabsContent Value="medications">
                @if (_summary.MedicationStatements.Count == 0 && _summary.MedicationAdministrations.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">@Localizer["App.PatientDetail.NoMedications"]</p>
                }
                else
                {
                    <ul class="list-disc space-y-1 pl-5">
                        @foreach (var m in _summary.MedicationStatements)
                        {
                            <li>@((m.Medication as Hl7.Fhir.Model.CodeableConcept)?.Text ?? Localizer["App.PatientDetail.UnspecifiedMedication"].Value)</li>
                        }
                        @foreach (var m in _summary.MedicationAdministrations)
                        {
                            <li>@((m.Medication as Hl7.Fhir.Model.CodeableConcept)?.Text ?? Localizer["App.PatientDetail.UnspecifiedMedication"].Value)</li>
                        }
                    </ul>
                }
            </BbTabsContent>
            <BbTabsContent Value="observations">
                @if (_summary.Observations.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">@Localizer["App.PatientDetail.NoObservations"]</p>
                }
                else
                {
                    <ul class="list-disc space-y-1 pl-5">
                        @foreach (var o in _summary.Observations)
                        {
                            <li>@(o.Code?.Text ?? o.Code?.Coding?.FirstOrDefault()?.Display ?? Localizer["App.PatientDetail.UnspecifiedObservation"].Value)</li>
                        }
                    </ul>
                }
            </BbTabsContent>
        </BbTabs>
    </section>
}

@code {
    [Parameter]
    public string ListId { get; set; } = string.Empty;

    [Parameter]
    public string ResearchSubjectId { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [Inject]
    private IOptions<NotificationOptions> NotificationOptionsAccessor { get; set; } = default!;

    private static readonly string[] StatusOptions = ["candidate", "screening", "eligible", "ineligible", "on-study", "withdrawn"];

    private PatientListEntryDto? _entry;
    private TrialSummaryDto? _trial;
    private PatientClinicalSummaryDto _summary = new();
    private IReadOnlyList<ResearchSubjectHistoryEntryDto> _history = [];
    private LatestLocationDto? _location;
    private string? _mrNumber;
    private bool _loading = true;
    private string? _errorMessage;
    private ClaimsPrincipal _user = new();

    protected override async Task OnInitializedAsync()
    {
        _user = AuthStateTask is not null ? (await AuthStateTask).User : new ClaimsPrincipal();

        try
        {
            var (trial, patients) = await ScreeningListService.GetListWithPatientsAsync(
                ListId, _user, NotificationOptionsAccessor.Value.NewSuggestionWindowDays, NotificationOptionsAccessor.Value.StalledLeadWindowDays);
            _trial = trial;
            _entry = patients.FirstOrDefault(p => p.ResearchSubjectId == ResearchSubjectId)
                ?? throw new FhirAccessException(Localizer["App.PatientDetail.NotFoundInList"]);

            BreadcrumbState.Set(
                new BreadcrumbItem(Localizer["App.Common.AllTrialsBreadcrumb"], "/"),
                new BreadcrumbItem(trial.StudyAcronym, $"/trials/{ListId}/patients"),
                new BreadcrumbItem(_entry.Name ?? _entry.PatientId));

            _summary = await PatientRecordService.GetClinicalSummaryAsync(_entry.PatientId);
            _mrNumber = _summary.Patient?.Identifier?
                .FirstOrDefault(i => i.Type?.Coding?.Any(c =>
                    c.System == FhirConstants.SystemIdentifierType && c.Code == FhirConstants.IdentifierTypeMedicalRecordNumber) ?? false)
                ?.Value;

            _history = await ResearchSubjectService.GetHistoryAsync(ResearchSubjectId);
            _location = await PatientRecordService.GetLatestLocationAsync(_entry.PatientId);
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (FhirAccessException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _errorMessage = Localizer["App.PatientDetail.LoadErrorFallback"];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnStatusChanged(string newStatus)
    {
        if (_entry is null || _trial is null)
        {
            return;
        }

        try
        {
            var updatedAt = await ResearchSubjectService.UpdateStatusAsync(ResearchSubjectId, newStatus, _trial.StudyAcronym, _user);
            _entry.Status = newStatus;
            _entry.LastUpdated = updatedAt ?? DateTimeOffset.UtcNow;
            Toast.Success(Localizer["App.Toast.StatusUpdated", Localizer[StatusDisplay.GetKey(newStatus)]], Localizer["App.Common.Saved"]);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, Localizer["App.Toast.StatusUpdateError"]);
        }
    }
}
