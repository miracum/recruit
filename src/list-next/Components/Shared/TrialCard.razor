@inject IStringLocalizer<SharedResources> Localizer

<div class="h-full cursor-pointer transition-shadow hover:shadow-md" @onclick="NavigateToPatients">
    <BbCard Class="flex h-full flex-col">
        <BbCardHeader>
            <div class="flex items-center justify-between gap-2">
                <BbCardTitle>@Trial.StudyAcronym</BbCardTitle>
                <BbBadge Variant="@(IsActive ? BadgeVariant.Secondary : BadgeVariant.Outline)">
                    @(IsActive ? Localizer["App.Dashboard.ActiveTab"] : Localizer["App.Dashboard.InactiveTab"])
                </BbBadge>
            </div>
        </BbCardHeader>
        <BbCardContent Class="flex-1">
            <div class="grid grid-cols-3 gap-4">
                <MetricTile Label="@Localizer["App.TrialCard.Recruited"]" Value="Trial.RecruitedCount" />
                <MetricTile Label="@Localizer["App.TrialCard.Pending"]" Value="Trial.PendingCount" />
                <MetricTile Label="@Localizer["App.TrialCard.NotRecruited"]" Value="Trial.NotRecruitedCount" />
            </div>
        </BbCardContent>
        <BbCardFooter Class="flex items-center justify-between">
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="h-2 w-2 rounded-full @(Trial.NewSuggestionsCount > 0 ? "bg-green-500" : "bg-muted-foreground/30")"></span>
                <LucideIcon Name="user" Size="14" />
                <span>@Trial.NewSuggestionsCount @(Trial.NewSuggestionsCount == 1 ? Localizer["App.TrialCard.NewSuggestionSingular"] : Localizer["App.TrialCard.NewSuggestionPlural"])</span>
            </div>
            @if (Trial.StalledLeadsCount > 0)
            {
                <div class="flex items-center gap-1.5 text-xs text-amber-600" title="@Localizer["App.TrialCard.StalledTooltip"]">
                    <LucideIcon Name="clock" Size="14" />
                    <span>@Localizer["App.TrialCard.StalledCount", Trial.StalledLeadsCount]</span>
                </div>
            }
        </BbCardFooter>
    </BbCard>
</div>

@code {
    [Parameter, EditorRequired]
    public required TrialSummaryDto Trial { get; set; }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private bool IsActive => Trial.ListStatus == "current";

    private void NavigateToPatients() => Navigation.NavigateTo($"/trials/{Trial.ListId}/patients");
}
