@using Ganss.Xss
@using Markdig
@using System.Text.RegularExpressions
@inject ResearchSubjectService ResearchSubjectService
@inject ToastService Toast
@inject IStringLocalizer<SharedResources> Localizer

<div>
    <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.Patient.Notes"]</span>

    <div class="mt-2 max-h-48 space-y-2 overflow-y-auto">
        @if (_loading)
        {
            <BbSkeleton Class="h-14 w-full" />
        }
        else if (_notes.Count == 0)
        {
            <p class="text-sm text-muted-foreground">@Localizer["App.PatientNotes.Empty"]</p>
        }
        else
        {
            @foreach (var note in _notes)
            {
                <div class="rounded border bg-muted/40 p-3">
                    <p class="text-xs text-muted-foreground">
                        @(note.Time?.LocalDateTime.ToString("g") ?? Localizer["App.PatientNotes.UnknownTime"])
                        @if (!string.IsNullOrEmpty(note.Author))
                        {
                            <span> &middot; @note.Author</span>
                        }
                    </p>
                    <div class="prose prose-sm dark:prose-invert max-w-none text-sm [&_p]:mb-2 [&_ul]:list-disc [&_ul]:ml-4 [&_ol]:list-decimal [&_ol]:ml-4 [&_li]:mb-1 [&_strong]:font-bold [&_em]:italic">@RenderNote(note.Text)</div>
                </div>
            }
        }
    </div>

    @if (CanEdit)
    {
        <BbRichTextEditor @bind-Value="_noteDraftHtml" Placeholder="@Localizer["App.PatientNotes.Placeholder"]" Class="mt-3" MinHeight="120px" />
        <div class="mt-2 flex items-center justify-end gap-3">
            <SaveStatusIndicator Saving="_saving" />
            <BbButton Variant="ButtonVariant.Default" Disabled="@(IsNoteDraftEmpty || _saving)"
                      Loading="_saving" OnClick="SaveNoteAsync">
                @Localizer["App.PatientNotes.AddButton"]
            </BbButton>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required PatientListEntryDto Patient { get; set; }

    [Parameter, EditorRequired]
    public required TrialIdentifier TrialIdentifier { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly MarkdownPipeline MarkdownPipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
    private static readonly HtmlSanitizer Sanitizer = new();
    private static readonly ReverseMarkdown.Converter HtmlToMarkdownConverter = new();
    private static readonly Regex HtmlTagRegex = new("<[^>]+>", RegexOptions.Compiled);

    private List<PatientNoteDto> _notes = [];
    private bool _loading;
    private string _noteDraftHtml = string.Empty;
    private string? _loadedForSubjectId;
    private ClaimsPrincipal _user = new();
    private bool _saving;

    /// <summary>Quill emits markup like "&lt;p&gt;&lt;br&gt;&lt;/p&gt;" for an empty editor, so a plain string check isn't enough.</summary>
    private bool IsNoteDraftEmpty => string.IsNullOrWhiteSpace(HtmlTagRegex.Replace(_noteDraftHtml, string.Empty).Replace("&nbsp;", " "));

    /// <summary>Notes are stored as Markdown (matching FHIR's Annotation.text type); render + sanitize for display.</summary>
    private static MarkupString RenderNote(string text) =>
        new(Sanitizer.Sanitize(Markdown.ToHtml(text, MarkdownPipeline)));

    protected override async Task OnParametersSetAsync()
    {
        _user = AuthStateTask is not null ? (await AuthStateTask).User : new ClaimsPrincipal();

        if (Patient.ResearchSubjectId != _loadedForSubjectId)
        {
            _loadedForSubjectId = Patient.ResearchSubjectId;
            _noteDraftHtml = string.Empty;
            await LoadNotesAsync();
        }
    }

    private async Task LoadNotesAsync()
    {
        _loading = true;
        try
        {
            _notes = [.. await ResearchSubjectService.GetNotesAsync(Patient.ResearchSubjectId)];
        }
        catch
        {
            // Best-effort - an empty notes list is preferable to blocking on a fetch failure.
            _notes = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveNoteAsync()
    {
        if (IsNoteDraftEmpty)
        {
            return;
        }

        var markdown = HtmlToMarkdownConverter.Convert(Sanitizer.Sanitize(_noteDraftHtml)).Trim();
        if (string.IsNullOrWhiteSpace(markdown))
        {
            return;
        }

        _saving = true;
        StateHasChanged();

        try
        {
            var updatedAt = await ResearchSubjectService.AddNoteAsync(Patient.ResearchSubjectId, markdown, TrialIdentifier, _user);
            Patient.Note = markdown;
            Patient.LastUpdated = updatedAt ?? DateTimeOffset.UtcNow;
            Toast.Success(Localizer["App.Toast.NoteSaved"], Localizer["App.Common.Saved"]);
            _noteDraftHtml = string.Empty;
            await LoadNotesAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, Localizer["App.Toast.NoteSaveError"]);
        }
        finally
        {
            _saving = false;
        }
    }
}
