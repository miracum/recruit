@inject ResearchSubjectService ResearchSubjectService
@inject ToastService Toast
@inject IStringLocalizer<SharedResources> Localizer

<BbDialog Open="Patient is not null" OpenChanged="HandleOpenChanged">
    <BbDialogContent Class="sm:max-w-xl">
        @if (Patient is not null)
        {
            <BbDialogHeader>
                <BbDialogTitle>@(Patient.Name ?? Patient.PatientId)</BbDialogTitle>
                <BbDialogDescription>
                    @(Patient.Age is not null ? Localizer["App.PatientDialog.AgeYo", Patient.Age] : Localizer["App.Common.AgeUnknown"])
                    &middot; @(Patient.Gender is not null ? Localizer[GenderDisplay.GetKey(Patient.Gender)].Value : Localizer["App.Common.GenderUnknown"].Value)
                    @if (!string.IsNullOrEmpty(Patient.LastKnownLocation))
                    {
                        <span> &middot; @Patient.LastKnownLocation</span>
                    }
                    <br />
                    <span class="font-medium text-foreground">@StudyAcronym</span>
                </BbDialogDescription>
            </BbDialogHeader>

            <BbTabs DefaultValue="details">
                <BbTabsList>
                    <BbTabsTrigger Value="details">@Localizer["App.PatientDialog.TabDetails"]</BbTabsTrigger>
                    <BbTabsTrigger Value="history">@Localizer["App.PatientDialog.TabHistory"]</BbTabsTrigger>
                </BbTabsList>
                <BbTabsContent Value="details">
                    <div class="space-y-4">
                        @if (!string.IsNullOrEmpty(Patient.Phone) || !string.IsNullOrEmpty(Patient.Email))
                        {
                            <div>
                                <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.Patient.Contact"]</span>
                                <div class="mt-2 space-y-1 text-sm">
                                    @if (!string.IsNullOrEmpty(Patient.Phone))
                                    {
                                        <p>@Patient.Phone</p>
                                    }
                                    @if (!string.IsNullOrEmpty(Patient.Email))
                                    {
                                        <p>@Patient.Email</p>
                                    }
                                </div>
                            </div>
                        }

                        <div>
                            <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.Patient.RecruitmentStatus"]</span>
                            <div class="mt-3 flex flex-wrap gap-x-8 gap-y-3">
                                @foreach (var status in StatusOptions)
                                {
                                    <label class="flex cursor-pointer items-center gap-2 text-sm">
                                        <input type="radio" name="recruitment-status" value="@status" checked="@(Patient.Status == status)"
                                               @onchange="() => OnStatusChangedInternal(status)" class="h-4 w-4" style="accent-color: var(--primary);" />
                                        @Localizer[StatusDisplay.GetKey(status)]
                                    </label>
                                }
                            </div>
                        </div>

                        <BbSeparator />

                        <PatientNotesSection Patient="Patient" StudyAcronym="@StudyAcronym" />
                    </div>
                </BbTabsContent>
                <BbTabsContent Value="history">
                    <PatientHistorySection Patient="Patient" />
                </BbTabsContent>
            </BbTabs>

            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" OnClick="Close">@Localizer["App.Common.Close"]</BbButton>
            </BbDialogFooter>
        }
    </BbDialogContent>
</BbDialog>

@code {
    [Parameter]
    public PatientListEntryDto? Patient { get; set; }

    [Parameter]
    public EventCallback<PatientListEntryDto?> PatientChanged { get; set; }

    [Parameter, EditorRequired]
    public required string StudyAcronym { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] StatusOptions = ["candidate", "screening", "eligible", "ineligible", "on-study", "withdrawn"];

    private ClaimsPrincipal _user = new();

    protected override async Task OnParametersSetAsync()
    {
        _user = AuthStateTask is not null ? (await AuthStateTask).User : new ClaimsPrincipal();
    }

    private async Task OnStatusChangedInternal(string newStatus)
    {
        if (Patient is null)
        {
            return;
        }

        try
        {
            var updatedAt = await ResearchSubjectService.UpdateStatusAsync(Patient.ResearchSubjectId, newStatus, StudyAcronym, _user);
            Patient.Status = newStatus;
            Patient.LastUpdated = updatedAt ?? DateTimeOffset.UtcNow;
            Toast.Success(Localizer["App.Toast.StatusUpdated", Localizer[StatusDisplay.GetKey(newStatus)]], Localizer["App.Common.Saved"]);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, Localizer["App.Toast.StatusUpdateError"]);
        }
    }

    private async Task Close() => await PatientChanged.InvokeAsync(null);

    private async Task HandleOpenChanged(bool open)
    {
        if (!open)
        {
            await Close();
        }
    }
}
