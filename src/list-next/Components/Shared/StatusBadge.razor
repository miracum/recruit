@inject IStringLocalizer<SharedResources> Localizer

<BbBadge Variant="Variant">@Localizer[StatusDisplay.GetKey(Status)]</BbBadge>

@code {
    [Parameter, EditorRequired]
    public required string Status { get; set; }

    private BadgeVariant Variant => Status switch
    {
        "on-study" => BadgeVariant.Default,
        "ineligible" or "withdrawn" => BadgeVariant.Destructive,
        _ => BadgeVariant.Secondary,
    };
}
