@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Authentication
@inject IHttpContextAccessor HttpContextAccessor
@inject TokenProvider TokenProvider

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h5" Class="ml-2">recruIT &mdash; Patient List</MudText>
        <MudSpacer />
        <AuthorizeView>
            <Authorized>
                <MudText Class="mr-4" Typo="Typo.body2">@context.User.Identity?.Name</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/Account/Logout">Log out</MudButton>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // HttpContext is only non-null during the initial (prerender) request; capture the
        // OIDC access token here once so FhirService can use it for the rest of this circuit's
        // lifetime, see TokenProvider for details.
        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is not null)
        {
            TokenProvider.AccessToken = await httpContext.GetTokenAsync("access_token");
        }
    }
}
