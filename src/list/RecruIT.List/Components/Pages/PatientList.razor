@page "/trials/{ListId}/patients"
@attribute [Authorize]
@inject ScreeningListService ScreeningListService
@inject EligibilityFunnelService FunnelService
@inject PatientRecordService PatientRecordService
@inject TrialAccessService AccessService
@inject BreadcrumbState BreadcrumbState
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@(_summary?.StudyAcronym ?? Localizer["App.Nav.Patients"])</PageTitle>

@if (_loading)
{
    <BbSkeleton Class="bb:mb-4 bb:h-8 bb:w-64" />
    <BbSkeleton Class="bb:w-full" />
}
else if (_errorMessage is not null)
{
    <BbAlert Variant="AlertVariant.Danger">
        <BbAlertTitle>@Localizer["App.PatientList.LoadErrorTitle"]</BbAlertTitle>
        <BbAlertDescription>@_errorMessage</BbAlertDescription>
    </BbAlert>
}
else if (_summary is not null)
{
    <div class="bb:flex bb:items-start bb:justify-between bb:gap-4">
        <div>
            @if (!string.IsNullOrEmpty(_summary.StudyTitle))
            {
                <h2 class="bb:text-lg bb:font-medium">@_summary.StudyTitle</h2>
            }
        </div>
        <div class="bb:flex bb:shrink-0 bb:items-center bb:gap-2">
            @if (_summary.Criteria.Count > 0 || FunnelChartData is { Count: > 0 })
            {
                @* Opened via OnClick rather than a BbSheetTrigger: the tooltip trigger already passes its own
                   trigger context to the button, so the two AsChild triggers would compete for it. *@
                <BbTooltip>
                    <BbTooltipTrigger AsChild="true">
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="bb:shrink-0"
                                  AriaLabel="@Localizer["App.PatientList.CriteriaButton"]" OnClick="@(() => _criteriaOpen = true)">
                            <LucideIcon Name="list-checks" Size="16" />
                        </BbButton>
                    </BbTooltipTrigger>
                    <BbTooltipContent>@Localizer["App.PatientList.CriteriaButton"]</BbTooltipContent>
                </BbTooltip>
                <BbSheet @bind-Open="_criteriaOpen">
                    @* Focus the panel rather than the first criterion, whose SQL popover would otherwise get the focus ring.
                       Width set inline: the precompiled bb: bundle has no utility wide enough to beat the sheet's sm:max-w-sm. *@
                    <BbSheetContent Class="bb:overflow-y-auto" InitialFocus="FocusTrapInitialFocus.Container"
                                    style="width: min(36rem, 100vw); max-width: 100vw;">
                        <BbSheetHeader>
                            <BbSheetTitle>@Localizer["App.PatientList.CriteriaButton"]</BbSheetTitle>
                            @if (!string.IsNullOrEmpty(_summary.StudyTitle))
                            {
                                <BbSheetDescription>@_summary.StudyTitle</BbSheetDescription>
                            }
                        </BbSheetHeader>
                        <div class="bb:flex bb:flex-col bb:gap-6 bb:px-4 bb:pb-4">
                            <div>
                                <span class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.PatientList.InclusionCriteria"]</span>
                                @if (InclusionCriteria.Count == 0)
                                {
                                    <p class="bb:mt-1.5 bb:text-sm bb:text-muted-foreground">@Localizer["App.PatientList.NoCriteria"]</p>
                                }
                                else
                                {
                                    <ul class="bb:mt-1.5 bb:space-y-1 bb:text-sm">
                                        @foreach (var criterion in InclusionCriteria)
                                        {
                                            <CriterionListItem Criterion="criterion" />
                                        }
                                    </ul>
                                }
                            </div>
                            <div>
                                <span class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.PatientList.ExclusionCriteria"]</span>
                                @if (ExclusionCriteria.Count == 0)
                                {
                                    <p class="bb:mt-1.5 bb:text-sm bb:text-muted-foreground">@Localizer["App.PatientList.NoCriteria"]</p>
                                }
                                else
                                {
                                    <ul class="bb:mt-1.5 bb:space-y-1 bb:text-sm">
                                        @foreach (var criterion in ExclusionCriteria)
                                        {
                                            <CriterionListItem Criterion="criterion" />
                                        }
                                    </ul>
                                }
                            </div>
                            @if (FunnelChartData is { Count: > 0 })
                            {
                                <div>
                                    <span class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.PatientList.FunnelSectionTitle"]</span>
                                    <BbFunnelChart Data="@FunnelChartData" Height="280px" Class="bb:mt-1.5">
                                        <BbChartTooltip />
                                        <BbFunnel DataKey="value" NameKey="stage" Sort="FunnelSort.None" LabelFormatter="{b}: {c}" MinSize="15%" />
                                    </BbFunnelChart>
                                </div>
                            }
                        </div>
                    </BbSheetContent>
                </BbSheet>
            }
            <NotificationSubscribeButton TrialIdentifier="_summary.TrialIdentifier" />
            @if (_canManageAccess)
            {
                <BbTooltip>
                    <BbTooltipTrigger AsChild="true">
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="bb:shrink-0"
                                  AriaLabel="@Localizer["App.PatientList.ManageAccessLink"]" OnClick="@(() => Navigation.NavigateTo($"/trials/{ListId}/access"))">
                            <LucideIcon Name="lock" Size="16" />
                        </BbButton>
                    </BbTooltipTrigger>
                    <BbTooltipContent>@Localizer["App.PatientList.ManageAccessLink"]</BbTooltipContent>
                </BbTooltip>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_summary.StudyDescription))
    {
        <p class="bb:mt-1 bb:text-sm bb:text-muted-foreground">@_summary.StudyDescription</p>
    }

    @if (_patients.Count == 0)
    {
        <BbEmpty Title="@Localizer["App.PatientList.EmptyTitle"]" Description="@Localizer["App.PatientList.EmptyDescription"]" />
    }
    else
    {
        <BbInput @bind-Value="_search" UpdateTiming="UpdateTiming.Debounced" DebounceInterval="300"
                 Placeholder="@Localizer["App.PatientList.SearchPlaceholder"]" Class="bb:mb-4 bb:max-w-sm" />
        <BbDataTable TData="PatientListEntryDto" Data="FilteredPatients" ShowToolbar="false" ShowPagination="true"
                     PageSizes="new[] { 10, 25, 50, 100 }" InitialPageSize="25" IsLoading="false">
            <Columns>
                <BbDataTableColumn TData="PatientListEntryDto" TValue="DateTimeOffset?" Header="@Localizer["App.PatientList.ColumnRecommended"]" Property="p => p.RecommendedDate" Sortable="true">
                    <CellTemplate Context="p">
                        <div class="bb:block bb:cursor-pointer bb:p-4" @onclick="() => OpenPatient(p)">
                            @(p.RecommendedDate?.LocalDateTime.ToString("d") ?? "-")
                            @if (p.IsNew(NewSuggestionWindowDays))
                            {
                                <BbBadge Variant="BadgeVariant.Default" Class="bb:ms-2">@Localizer["App.PatientList.NewBadge"]</BbBadge>
                            }
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="PatientListEntryDto" TValue="string" Header="@Localizer["App.PatientList.ColumnName"]" Property="p => p.Name ?? p.MedicalRecordNumber ?? p.PatientId" Sortable="true">
                    <CellTemplate Context="p">
                        <div class="bb:block bb:cursor-pointer bb:p-4" @onclick="() => OpenPatient(p)">
                            <span class="bb:font-medium bb:hover:underline">@(p.Name ?? p.MedicalRecordNumber ?? p.PatientId)</span>
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="PatientListEntryDto" TValue="int?" Header="@Localizer["App.PatientList.ColumnDemographics"]" Width="140px">
                    <CellTemplate Context="p">
                        <div class="bb:block bb:cursor-pointer bb:p-4" @onclick="() => OpenPatient(p)">
                            @(p.Age is not null ? p.Age.ToString() : Localizer["App.Common.AgeUnknown"].Value)
                            <span class="bb:text-muted-foreground">&middot;</span>
                            @(p.Gender is not null ? Localizer[GenderDisplay.GetKey(p.Gender)].Value : Localizer["App.Common.Unknown"].Value)
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="PatientListEntryDto" TValue="string" Header="@Localizer["App.PatientList.ColumnStatus"]">
                    <CellTemplate Context="p">
                        <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:cursor-pointer bb:p-4" @onclick="() => OpenPatient(p)">
                            <StatusBadge Status="@p.Status" />
                            @if (p.SystemDeterminedIneligible)
                            {
                                <BbBadge Variant="BadgeVariant.Outline">@Localizer["App.PatientList.SystemIneligibleBadge"]</BbBadge>
                            }
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="PatientListEntryDto" TValue="string" Header="@Localizer["App.PatientList.ColumnLocation"]">
                    <CellTemplate Context="p">
                        <div class="bb:block bb:cursor-pointer bb:p-4" @onclick="() => OpenPatient(p)">
                            @if (p.LastKnownLocationLoaded)
                            {
                                @(p.LastKnownLocation ?? Localizer["App.Common.Unknown"].Value)
                            }
                            else
                            {
                                <BbSkeleton Class="bb:h-4 bb:w-24" />
                            }
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="PatientListEntryDto" TValue="DateTimeOffset?" Header="@Localizer["App.PatientList.ColumnUpdated"]" Property="p => p.LastUpdated" Sortable="true">
                    <CellTemplate Context="p">
                        <div class="bb:block bb:cursor-pointer bb:p-4" @onclick="() => OpenPatient(p)">
                            @(p.LastUpdated?.LocalDateTime.ToString("g") ?? "-")
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
            </Columns>
        </BbDataTable>
    }

    <PatientDialog Patient="_selectedPatient" PatientChanged="p => _selectedPatient = p"
                   Acronym="@_summary.StudyAcronym" StudyTitle="@_summary.StudyTitle"
                   TrialIdentifier="_summary.TrialIdentifier" CanEdit="_canEdit" />
}

@code {
    [Parameter]
    public string ListId { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    [Inject]
    private IOptions<NotificationOptions> NotificationOptionsAccessor { get; set; } = default!;

    private TrialSummaryDto? _summary;
    private List<PatientListEntryDto> _patients = [];
    private string _search = string.Empty;
    private bool _criteriaOpen;
    private List<FunnelStepDto>? _funnelSteps;
    private bool _loading = true;
    private bool _canEdit;
    private bool _canManageAccess;
    private string? _errorMessage;
    private ClaimsPrincipal _user = new();

    private PatientListEntryDto? _selectedPatient;

    /// <summary>
    /// Replaces the data table's own toolbar search, which comes with an unwanted column-visibility
    /// button - matches what the table shows: name, MRN, patient id and last known location.
    /// </summary>
    private List<PatientListEntryDto> FilteredPatients => string.IsNullOrWhiteSpace(_search)
        ? _patients
        : [.. _patients.Where(p =>
            Matches(p.Name) || Matches(p.MedicalRecordNumber) || Matches(p.PatientId) || Matches(p.LastKnownLocation))];

    private bool Matches(string? value) => value?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false;

    private int NewSuggestionWindowDays => NotificationOptionsAccessor.Value.NewSuggestionWindowDays;

    private List<CriterionDefinitionDto> InclusionCriteria => _summary?.Criteria.Where(c => !c.Exclude).ToList() ?? [];

    private List<CriterionDefinitionDto> ExclusionCriteria => _summary?.Criteria.Where(c => c.Exclude).ToList() ?? [];

    private List<FunnelChartPoint>? FunnelChartData =>
        _funnelSteps
            ?.Select(s => new FunnelChartPoint(
                s.IsTotalPopulation
                    ? Localizer["App.PatientList.FunnelTotalPopulationLabel"].Value
                    : s.Label ?? string.Empty,
                s.Count
            ))
            .ToList();

    private record FunnelChartPoint(string Stage, int Value);

    protected override async Task OnInitializedAsync()
    {
        _user = await AuthStateTask.GetUserAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var (summary, patients) = await ScreeningListService.GetListWithPatientsAsync(ListId, _user);
            _summary = summary;
            _patients = [.. patients];
            var permission = await AccessService.GetPermissionAsync(_user, summary.TrialIdentifier);
            _canEdit = TrialAccessService.MeetsCoordinatorThreshold(permission);
            _canManageAccess = TrialAccessService.MeetsTrialAdminThreshold(permission);
            BreadcrumbState.Set(new BreadcrumbItem(Localizer["App.Common.AllTrialsBreadcrumb"], "/"), new BreadcrumbItem(summary.StudyAcronym));
            _funnelSteps = await TryLoadFunnelAsync(summary.StudyId);

            // Fire-and-forget rather than gating on OnAfterRenderAsync(firstRender): when
            // GetListWithPatientsAsync resolves fast enough (e.g. a warm connection from in-app
            // navigation), Blazor can fold the whole initial load into a single render, so the
            // "first" OnAfterRenderAsync would already be past firstRender=true and this would
            // never fire on a cold/direct page load where the fetch takes longer.
            if (_patients.Count > 0)
            {
                _ = LoadLocationsInBackgroundAsync();
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (FhirAccessException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _errorMessage = Localizer["App.PatientList.LoadErrorFallback"];
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// The funnel is an optional, best-effort enhancement - most studies won't have one yet (the
    /// query-sql-on-fhir feature flag producing it defaults to off), and a failure fetching it
    /// shouldn't block the rest of the page from loading.
    /// </summary>
    private async Task<List<FunnelStepDto>?> TryLoadFunnelAsync(string studyId)
    {
        try
        {
            var steps = await FunnelService.GetFunnelAsync(studyId);
            return steps?.ToList();
        }
        catch (Exception)
        {
            return null;
        }
    }

    private async Task LoadLocationsInBackgroundAsync()
    {
        using var throttle = new SemaphoreSlim(8);
        var tasks = _patients.Select(async patient =>
        {
            await throttle.WaitAsync();
            try
            {
                var location = await PatientRecordService.GetLatestLocationAsync(patient.PatientId);
                patient.LastKnownLocation = location?.LocationName;
            }
            catch
            {
                patient.LastKnownLocation = null;
            }
            finally
            {
                patient.LastKnownLocationLoaded = true;
                throttle.Release();
                await InvokeAsync(StateHasChanged);
            }
        });

        await Task.WhenAll(tasks);
    }

    private void OpenPatient(PatientListEntryDto patient) => _selectedPatient = patient;
}
