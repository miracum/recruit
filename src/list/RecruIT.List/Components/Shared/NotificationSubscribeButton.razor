@inject IStringLocalizer<SharedResources> Localizer
@inject NotificationSubscriptionService NotificationSubscriptionService
@inject IJSRuntime JS
@inject ToastService Toast

<BbPopover Open="_open" OpenChanged="@(open => _open = open)">
    <BbPopoverTrigger AsChild="true">
        <BbButton Variant="@(_subscribed ? ButtonVariant.Secondary : ButtonVariant.Outline)" Size="ButtonSize.Icon"
                  Class="shrink-0" AriaLabel="@Localizer["App.Subscription.ButtonLabel"]">
            <LucideIcon Name="@(_subscribed ? "bell-ring" : "bell")" Size="16" />
        </BbButton>
    </BbPopoverTrigger>
    <BbPopoverContent Side="PopoverSide.Bottom" Align="PopoverAlign.End" Class="w-80">
        <div class="space-y-4">
            <div class="flex items-start justify-between gap-3">
                <div>
                    <p class="text-sm font-medium">@Localizer["App.Subscription.PopoverTitle"]</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@Localizer["App.Subscription.PopoverDescription"]</p>
                </div>
                <BbSwitch Checked="_subscribed" CheckedChanged="@(v => _subscribed = v)" AriaLabel="@Localizer["App.Subscription.ButtonLabel"]" Class="mt-0.5 shrink-0" />
            </div>

            @if (_subscribed)
            {
                <BbSeparator />

                <div>
                    <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.Subscription.FrequencyLabel"]</span>
                    <BbRadioGroup TValue="NotificationFrequency" Value="_frequency" ValueChanged="@(v => _frequency = v)" Class="mt-2 flex flex-col gap-2">
                        <BbRadioGroupItem TValue="NotificationFrequency" Value="NotificationFrequency.Instant" Label="@Localizer["App.Subscription.FrequencyInstant"]" />
                        <BbRadioGroupItem TValue="NotificationFrequency" Value="NotificationFrequency.Daily" Label="@Localizer["App.Subscription.FrequencyDaily"]" />
                        <BbRadioGroupItem TValue="NotificationFrequency" Value="NotificationFrequency.Weekly" Label="@Localizer["App.Subscription.FrequencyWeekly"]" />
                        <BbRadioGroupItem TValue="NotificationFrequency" Value="NotificationFrequency.Monthly" Label="@Localizer["App.Subscription.FrequencyMonthly"]" />
                    </BbRadioGroup>
                </div>

                @if (_frequency == NotificationFrequency.Monthly)
                {
                    <p class="text-xs text-muted-foreground">@Localizer["App.Subscription.MonthlyNote"]</p>
                }
                else if (_frequency == NotificationFrequency.Weekly)
                {
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.Subscription.DayOfWeekLabel"]</label>
                            <BbSelect TValue="DayOfWeek" @bind-Value="_dayOfWeek" Class="mt-1 w-full">
                                <BbSelectTrigger>
                                    <BbSelectValue />
                                </BbSelectTrigger>
                                <BbSelectContent>
                                    @foreach (var day in DayOfWeekOptions)
                                    {
                                        <BbSelectItem TValue="DayOfWeek" Value="@day" Text="@Localizer[DayOfWeekKey(day)]" />
                                    }
                                </BbSelectContent>
                            </BbSelect>
                        </div>
                        @TimeInput
                    </div>
                }
                else if (_frequency == NotificationFrequency.Daily)
                {
                    @TimeInput
                }
            }

            <div class="flex justify-end pt-1">
                <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" Loading="_saving" OnClick="SaveAsync">
                    @Localizer["App.Subscription.SaveButton"]
                </BbButton>
            </div>
        </div>
    </BbPopoverContent>
</BbPopover>

@code {
    [Parameter, EditorRequired]
    public required TrialIdentifier TrialIdentifier { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly DayOfWeek[] DayOfWeekOptions =
    [
        DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday,
        DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday,
    ];

    private static readonly TimeSpan DefaultTime = new(9, 0, 0);

    private ClaimsPrincipal _user = new();
    private bool _open;
    private bool _subscribed;
    private bool _saving;
    private NotificationFrequency _frequency = NotificationFrequency.Instant;
    private DayOfWeek _dayOfWeek = DayOfWeek.Monday;
    private TimeSpan? _time = DefaultTime;

    /// <summary>The Daily/Weekly time-of-day input, identical in both frequencies' markup.</summary>
    private RenderFragment TimeInput =>
        @<div>
            <label class="text-xs font-medium uppercase tracking-wide text-muted-foreground">@Localizer["App.Subscription.TimeLabel"]</label>
            <BbTimePicker @bind-Value="_time" Format="TimeFormat.Hour24" Class="mt-1 h-9 w-full" />
        </div>;

    protected override async Task OnInitializedAsync()
    {
        _user = await AuthStateTask.GetUserAsync();

        var subscription = await NotificationSubscriptionService.GetAsync(_user, TrialIdentifier);
        if (subscription is not null)
        {
            _subscribed = true;
            _frequency = subscription.Frequency;
            _dayOfWeek = subscription.DayOfWeek ?? DayOfWeek.Monday;
            _time = subscription.TimeOfDay?.ToTimeSpan() ?? DefaultTime;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (_subscribed)
            {
                // Read right before saving, not on init - JS interop needs the interactive circuit
                // attached, and there's no reason to pay for it before the user actually subscribes.
                var timeZoneId = await JS.InvokeAsync<string>(
                    "eval",
                    "Intl.DateTimeFormat().resolvedOptions().timeZone"
                );
                DayOfWeek? dayOfWeek = _frequency == NotificationFrequency.Weekly ? _dayOfWeek : null;
                TimeOnly? timeOfDay =
                    _frequency is NotificationFrequency.Daily or NotificationFrequency.Weekly
                        ? TimeOnly.FromTimeSpan(_time ?? DefaultTime)
                        : null;

                await NotificationSubscriptionService.SubscribeAsync(
                    _user,
                    TrialIdentifier,
                    _frequency,
                    dayOfWeek,
                    timeOfDay,
                    timeZoneId
                );
            }
            else
            {
                await NotificationSubscriptionService.UnsubscribeAsync(_user, TrialIdentifier);
            }

            Toast.Success(Localizer["App.Subscription.SavedToast"], Localizer["App.Common.Saved"]);
            _open = false;
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, Localizer["App.Subscription.SaveErrorTitle"]);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string DayOfWeekKey(DayOfWeek day) =>
        day switch
        {
            DayOfWeek.Monday => "App.Subscription.DayMonday",
            DayOfWeek.Tuesday => "App.Subscription.DayTuesday",
            DayOfWeek.Wednesday => "App.Subscription.DayWednesday",
            DayOfWeek.Thursday => "App.Subscription.DayThursday",
            DayOfWeek.Friday => "App.Subscription.DayFriday",
            DayOfWeek.Saturday => "App.Subscription.DaySaturday",
            _ => "App.Subscription.DaySunday",
        };
}
