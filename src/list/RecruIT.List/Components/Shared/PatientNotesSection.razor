@using System.Text.RegularExpressions
@inject ScreeningNoteService ScreeningNoteService
@inject ToastService Toast
@inject IStringLocalizer<SharedResources> Localizer

<div>
    <span class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.Patient.Notes"]</span>

    <div class="bb:mt-2 bb:max-h-48 bb:space-y-2 bb:overflow-y-auto">
        @if (_loading)
        {
            <BbSkeleton Class="bb:h-14 bb:w-full" />
        }
        else if (_notes.Count == 0)
        {
            <p class="bb:text-sm bb:text-muted-foreground">@Localizer["App.PatientNotes.Empty"]</p>
        }
        else
        {
            @foreach (var note in _notes)
            {
                <div class="bb:rounded bb:border bb:bg-muted/40 bb:p-3">
                    <p class="bb:text-xs bb:text-muted-foreground">
                        @(note.Time?.LocalDateTime.ToString("g") ?? Localizer["App.PatientNotes.UnknownTime"])
                        @if (!string.IsNullOrEmpty(note.Author))
                        {
                            <span> &middot; @note.Author</span>
                        }
                    </p>
                    <div class="bb:max-w-none bb:text-sm bb:[&_p]:mb-2 bb:[&_ul]:list-disc bb:[&_ul]:ms-4 bb:[&_ol]:list-decimal bb:[&_ol]:ms-4 bb:[&_li]:mb-1 bb:[&_strong]:font-bold bb:[&_em]:italic">@RenderNote(note.Text)</div>
                </div>
            }
        }
    </div>

    @if (CanEdit && Patient.ResearchSubjectIdentifier is not null)
    {
        <BbRichTextEditor @bind-Value="_noteDraftHtml" Placeholder="@Localizer["App.PatientNotes.Placeholder"]" Class="bb:mt-3" MinHeight="120px" />
        <div class="bb:mt-2 bb:flex bb:items-center bb:justify-end bb:gap-3">
            <SaveStatusIndicator Saving="_saving" />
            <BbButton Variant="ButtonVariant.Default" Disabled="@(IsNoteDraftEmpty || _saving)"
                      Loading="_saving" OnClick="SaveNoteAsync">
                @Localizer["App.PatientNotes.AddButton"]
            </BbButton>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required PatientListEntryDto Patient { get; set; }

    [Parameter, EditorRequired]
    public required TrialIdentifier TrialIdentifier { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly Regex HtmlTagRegex = new("<[^>]+>", RegexOptions.Compiled);

    private List<ScreeningNoteDto> _notes = [];
    private bool _loading;
    private string _noteDraftHtml = string.Empty;
    private string? _loadedForSubjectId;
    private ClaimsPrincipal _user = new();
    private bool _saving;

    /// <summary>Quill emits markup like "&lt;p&gt;&lt;br&gt;&lt;/p&gt;" for an empty editor, so a plain string check isn't enough.</summary>
    private bool IsNoteDraftEmpty => IsEffectivelyEmpty(_noteDraftHtml);

    private static bool IsEffectivelyEmpty(string html) =>
        string.IsNullOrWhiteSpace(HtmlTagRegex.Replace(html, string.Empty).Replace("&nbsp;", " "));

    /// <summary>
    /// ScreeningNoteService.AddNoteAsync sanitizes before persisting, so this is redundant
    /// defense-in-depth against the storage invariant ever being violated (e.g. a row written some
    /// other way) - cheap and harmless given NoteHtmlSanitizer.Sanitize is idempotent.
    /// </summary>
    private static MarkupString RenderNote(string html) => new(NoteHtmlSanitizer.Sanitize(html));

    protected override async Task OnParametersSetAsync()
    {
        _user = await AuthStateTask.GetUserAsync();

        if (Patient.ResearchSubjectId != _loadedForSubjectId)
        {
            _loadedForSubjectId = Patient.ResearchSubjectId;
            _noteDraftHtml = string.Empty;
            await LoadNotesAsync();
        }
    }

    private async Task LoadNotesAsync()
    {
        if (Patient.ResearchSubjectIdentifier is not { } researchSubjectIdentifier)
        {
            _notes = [];
            return;
        }

        _loading = true;
        try
        {
            _notes = [.. await ScreeningNoteService.GetNotesAsync(researchSubjectIdentifier)];
        }
        catch
        {
            // Best-effort - an empty notes list is preferable to blocking on a fetch failure.
            _notes = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveNoteAsync()
    {
        if (IsNoteDraftEmpty || Patient.ResearchSubjectIdentifier is not { } researchSubjectIdentifier)
        {
            return;
        }

        var sanitizedHtml = NoteHtmlSanitizer.Sanitize(_noteDraftHtml);
        if (IsEffectivelyEmpty(sanitizedHtml))
        {
            return;
        }

        _saving = true;
        StateHasChanged();

        try
        {
            await ScreeningNoteService.AddNoteAsync(researchSubjectIdentifier, sanitizedHtml, TrialIdentifier, _user);
            Toast.Success(Localizer["App.Toast.NoteSaved"], Localizer["App.Common.Saved"]);
            _noteDraftHtml = string.Empty;
            await LoadNotesAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, Localizer["App.Toast.NoteSaveError"]);
        }
        finally
        {
            _saving = false;
        }
    }
}
