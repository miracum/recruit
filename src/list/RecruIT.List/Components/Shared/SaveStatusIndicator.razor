@inject IStringLocalizer<SharedResources> Localizer

@if (Saving)
{
    <span class="bb:inline-flex bb:items-center bb:gap-1.5 bb:text-xs bb:text-muted-foreground" role="status">
        <BbSpinner Size="SpinnerSize.Small" Class="bb:h-3.5 bb:w-3.5" />
        @Localizer["App.Common.Saving"]
    </span>
}

@code {
    [Parameter]
    public bool Saving { get; set; }
}
