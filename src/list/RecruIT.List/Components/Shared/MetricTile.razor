<div class="bb:flex bb:flex-col bb:gap-1">
    <span class="bb:text-xs bb:text-muted-foreground">@Label</span>
    <span class="bb:text-2xl bb:font-semibold">@Value</span>
</div>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public int Value { get; set; }
}
