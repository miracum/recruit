<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["styles/theme.css"]" />
    <link rel="stylesheet" href="_content/BlazorBlueprint.Components/blazorblueprint.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["RecruIT.List.styles.css"]" />
    <link rel="stylesheet" href="@Assets["lib/quill/quill.core.css"]" />
    @* Applies the saved theme before the first paint, so there is no flash of the light theme
       while the circuit connects and ThemeService.InitializeAsync re-applies it. Must stay a
       classic, blocking script - type="module" would defer it past that paint. *@
    <script src="_content/BlazorBlueprint.Components/js/theme-init.js"></script>
    <ImportMap />
    <link rel="icon" type="image/png" sizes="48x48" href="@Assets["favicon-48.png"]" />
    <link rel="icon" type="image/png" sizes="16x16" href="@Assets["favicon-16.png"]" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["lib/quill/quill.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
