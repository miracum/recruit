{
  "name": "list",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "format": "oxfmt -c ../.oxfmtrc.json --write src tests/unit",
    "format:check": "oxfmt -c ../.oxfmtrc.json --check src tests/unit",
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "lint:eslint": "eslint src tests/unit",
    "lint:oxlint": "oxlint -c .oxlintrc.json src tests/unit",
    "serve": "vite",
    "test:e2e": "npm --prefix tests/e2e test",
    "test:unit": "vitest run --coverage"
  },
  "dependencies": {
    "@dsb-norge/vue-keycloak-js": "3.0.8",
    "@fortawesome/fontawesome-svg-core": "1.2.36",
    "@fortawesome/free-solid-svg-icons": "5.15.4",
    "@fortawesome/vue-fontawesome": "3.3.3",
    "axios": "1.18.1",
    "buefy": "3.0.9",
    "bulma": "1.0.4",
    "csv-stringify": "6.8.1",
    "fhirclient": "2.6.3",
    "fhirpath": "5.0.0",
    "vue": "3.5.40",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.24",
    "@vue/test-utils": "2.4.11",
    "esbuild": "0.28.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.76.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "js-yaml": "5.2.2",
    "jsdom": "30.0.1",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "pino": "10.3.1",
    "sass": "1.102.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
