@page "/trials/{ListId}/patients/{ResearchSubjectId}"
@attribute [Authorize]
@inject ScreeningListService ScreeningListService
@inject ResearchSubjectService ResearchSubjectService
@inject PatientRecordService PatientRecordService
@inject ToastService Toast
@inject BreadcrumbState BreadcrumbState

<PageTitle>@(_entry?.Name ?? "Patient")</PageTitle>

@if (_loading)
{
    <BbSkeleton Class="mb-4 h-8 w-64" />
    <BbSkeleton Class="h-64 w-full" />
}
else if (_errorMessage is not null)
{
    <BbAlert Variant="AlertVariant.Danger">
        <BbAlertTitle>Could not load this patient</BbAlertTitle>
        <BbAlertDescription>@_errorMessage</BbAlertDescription>
    </BbAlert>
}
else if (_entry is not null)
{
    <p class="mb-4 text-sm text-muted-foreground">
        @(_entry.Age is not null ? $"{_entry.Age} years old" : "Age unknown"), @(_entry.Gender ?? "gender unknown")
        @if (_mrNumber is not null)
        {
            <span> &middot; MR @_mrNumber</span>
        }
    </p>

    <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Recruitment status</BbCardTitle>
            </BbCardHeader>
            <BbCardContent>
                <BbField>
                    <BbFieldLabel For="status">Status</BbFieldLabel>
                    <BbNativeSelect TValue="string" Id="status" Value="_entry.Status" ValueChanged="OnStatusChanged">
                        @foreach (var status in StatusOptions)
                        {
                            <option value="@status">@status</option>
                        }
                    </BbNativeSelect>
                </BbField>
                <p class="mt-2 text-sm text-muted-foreground">
                    Last known location: @(_location?.LocationName ?? "unknown")
                </p>
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Note</BbCardTitle>
                <BbCardDescription>Visible to anyone with access to this trial.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <BbTextarea @bind-Value="_noteDraft" Placeholder="Add a note about this patient..." />
            </BbCardContent>
            <BbCardFooter>
                <BbButton Variant="ButtonVariant.Default" OnClick="SaveNoteAsync">Save note</BbButton>
            </BbCardFooter>
        </BbCard>
    </div>

    @if (_history.Count > 0)
    {
        <section class="mb-6">
            <h2 class="mb-3 text-lg font-medium">Status history</h2>
            <BbTimeline>
                @foreach (var entry in _history)
                {
                    <BbTimelineItem Title="@entry.Status" Time="@entry.LastUpdated.LocalDateTime.ToString("g")"
                                     Description="@(entry.Note is not null ? $"Note: {entry.Note}" : null)" />
                }
            </BbTimeline>
        </section>
    }

    <section>
        <h2 class="mb-3 text-lg font-medium">Clinical summary</h2>
        <BbTabs DefaultValue="conditions">
            <BbTabsList>
                <BbTabsTrigger Value="conditions">Conditions (@_summary.Conditions.Count)</BbTabsTrigger>
                <BbTabsTrigger Value="procedures">Procedures (@_summary.Procedures.Count)</BbTabsTrigger>
                <BbTabsTrigger Value="medications">Medications (@(_summary.MedicationStatements.Count + _summary.MedicationAdministrations.Count))</BbTabsTrigger>
                <BbTabsTrigger Value="observations">Observations (@_summary.Observations.Count)</BbTabsTrigger>
            </BbTabsList>
            <BbTabsContent Value="conditions">
                @if (_summary.Conditions.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No conditions recorded.</p>
                }
                else
                {
                    <ul class="list-disc space-y-1 pl-5">
                        @foreach (var c in _summary.Conditions)
                        {
                            <li>@(c.Code?.Text ?? c.Code?.Coding?.FirstOrDefault()?.Display ?? "Unspecified condition")</li>
                        }
                    </ul>
                }
            </BbTabsContent>
            <BbTabsContent Value="procedures">
                @if (_summary.Procedures.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No procedures recorded.</p>
                }
                else
                {
                    <ul class="list-disc space-y-1 pl-5">
                        @foreach (var p in _summary.Procedures)
                        {
                            <li>@(p.Code?.Text ?? p.Code?.Coding?.FirstOrDefault()?.Display ?? "Unspecified procedure")</li>
                        }
                    </ul>
                }
            </BbTabsContent>
            <BbTabsContent Value="medications">
                @if (_summary.MedicationStatements.Count == 0 && _summary.MedicationAdministrations.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No medications recorded.</p>
                }
                else
                {
                    <ul class="list-disc space-y-1 pl-5">
                        @foreach (var m in _summary.MedicationStatements)
                        {
                            <li>@((m.Medication as Hl7.Fhir.Model.CodeableConcept)?.Text ?? "Unspecified medication")</li>
                        }
                        @foreach (var m in _summary.MedicationAdministrations)
                        {
                            <li>@((m.Medication as Hl7.Fhir.Model.CodeableConcept)?.Text ?? "Unspecified medication")</li>
                        }
                    </ul>
                }
            </BbTabsContent>
            <BbTabsContent Value="observations">
                @if (_summary.Observations.Count == 0)
                {
                    <p class="text-sm text-muted-foreground">No observations recorded.</p>
                }
                else
                {
                    <ul class="list-disc space-y-1 pl-5">
                        @foreach (var o in _summary.Observations)
                        {
                            <li>@(o.Code?.Text ?? o.Code?.Coding?.FirstOrDefault()?.Display ?? "Unspecified observation")</li>
                        }
                    </ul>
                }
            </BbTabsContent>
        </BbTabs>
    </section>
}

@code {
    [Parameter]
    public string ListId { get; set; } = string.Empty;

    [Parameter]
    public string ResearchSubjectId { get; set; } = string.Empty;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] StatusOptions = ["candidate", "screening", "eligible", "ineligible", "on-study", "withdrawn"];

    private PatientListEntryDto? _entry;
    private TrialSummaryDto? _trial;
    private PatientClinicalSummaryDto _summary = new();
    private IReadOnlyList<ResearchSubjectHistoryEntryDto> _history = [];
    private LatestLocationDto? _location;
    private string? _mrNumber;
    private string _noteDraft = string.Empty;
    private bool _loading = true;
    private string? _errorMessage;
    private ClaimsPrincipal _user = new();

    protected override async Task OnInitializedAsync()
    {
        _user = AuthStateTask is not null ? (await AuthStateTask).User : new ClaimsPrincipal();

        try
        {
            var (trial, patients) = await ScreeningListService.GetListWithPatientsAsync(ListId, _user);
            _trial = trial;
            _entry = patients.FirstOrDefault(p => p.ResearchSubjectId == ResearchSubjectId)
                ?? throw new FhirAccessException("This patient could not be found in the trial's recommendation list.");
            _noteDraft = _entry.Note ?? string.Empty;

            BreadcrumbState.Set(
                new BreadcrumbItem("All trials", "/"),
                new BreadcrumbItem(trial.StudyAcronym, $"/trials/{ListId}/patients"),
                new BreadcrumbItem(_entry.Name ?? _entry.PatientId));

            _summary = await PatientRecordService.GetClinicalSummaryAsync(_entry.PatientId);
            _mrNumber = _summary.Patient?.Identifier?
                .FirstOrDefault(i => i.Type?.Coding?.Any(c =>
                    c.System == FhirConstants.SystemIdentifierType && c.Code == FhirConstants.IdentifierTypeMedicalRecordNumber) ?? false)
                ?.Value;

            _history = await ResearchSubjectService.GetHistoryAsync(ResearchSubjectId);
            _location = await PatientRecordService.GetLatestLocationAsync(_entry.PatientId);
        }
        catch (UnauthorizedAccessException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (FhirAccessException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _errorMessage = "An unexpected error occurred while loading this patient.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnStatusChanged(string newStatus)
    {
        if (_entry is null || _trial is null)
        {
            return;
        }

        try
        {
            await ResearchSubjectService.UpdateStatusAsync(ResearchSubjectId, newStatus, _trial.StudyAcronym, _user);
            _entry.Status = newStatus;
            Toast.Success($"Status updated to \"{newStatus}\".", "Saved");
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, "Could not update status");
        }
    }

    private async Task SaveNoteAsync()
    {
        if (_entry is null || _trial is null)
        {
            return;
        }

        try
        {
            await ResearchSubjectService.UpdateNoteAsync(ResearchSubjectId, _noteDraft, _trial.StudyAcronym, _user);
            Toast.Success("Note saved.", "Saved");
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, "Could not save note");
        }
    }
}
