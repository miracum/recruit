@inject ResearchSubjectService ResearchSubjectService
@inject ToastService Toast

<div>
    <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Notes</span>

    <div class="mt-2 max-h-48 space-y-2 overflow-y-auto">
        @if (_loading)
        {
            <BbSkeleton Class="h-14 w-full" />
        }
        else if (_notes.Count == 0)
        {
            <p class="text-sm text-muted-foreground">No notes yet.</p>
        }
        else
        {
            @foreach (var note in _notes)
            {
                <div class="rounded border bg-muted/40 p-3">
                    <p class="text-xs text-muted-foreground">
                        @(note.Time?.LocalDateTime.ToString("MMM d, yyyy 'at' HH:mm") ?? "Unknown time")
                        @if (!string.IsNullOrEmpty(note.Author))
                        {
                            <span> &middot; @note.Author</span>
                        }
                    </p>
                    <p class="text-sm">@note.Text</p>
                </div>
            }
        }
    </div>

    <BbTextarea @bind-Value="_noteDraft" UpdateTiming="UpdateTiming.Immediate" Placeholder="Add a screening note..." Class="mt-3" />
    <div class="mt-2 flex justify-end">
        <BbButton Variant="ButtonVariant.Default" Disabled="string.IsNullOrWhiteSpace(_noteDraft)" OnClick="SaveNoteAsync">
            Add note
        </BbButton>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public required PatientListEntryDto Patient { get; set; }

    [Parameter, EditorRequired]
    public required string StudyAcronym { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<PatientNoteDto> _notes = [];
    private bool _loading;
    private string _noteDraft = string.Empty;
    private string? _loadedForSubjectId;
    private ClaimsPrincipal _user = new();

    protected override async Task OnParametersSetAsync()
    {
        _user = AuthStateTask is not null ? (await AuthStateTask).User : new ClaimsPrincipal();

        if (Patient.ResearchSubjectId != _loadedForSubjectId)
        {
            _loadedForSubjectId = Patient.ResearchSubjectId;
            _noteDraft = string.Empty;
            await LoadNotesAsync();
        }
    }

    private async Task LoadNotesAsync()
    {
        _loading = true;
        try
        {
            _notes = [.. await ResearchSubjectService.GetNotesAsync(Patient.ResearchSubjectId)];
        }
        catch
        {
            // Best-effort - an empty notes list is preferable to blocking on a fetch failure.
            _notes = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_noteDraft))
        {
            return;
        }

        try
        {
            var updatedAt = await ResearchSubjectService.AddNoteAsync(Patient.ResearchSubjectId, _noteDraft, StudyAcronym, _user);
            Patient.Note = _noteDraft;
            Patient.LastUpdated = updatedAt ?? DateTimeOffset.UtcNow;
            Toast.Success("Note saved.", "Saved");
            _noteDraft = string.Empty;
            await LoadNotesAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, "Could not save note");
        }
    }
}
