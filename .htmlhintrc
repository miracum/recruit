// MegaLinter's default HTMLHint config (TEMPLATES/.htmlhintrc), adjusted for the Jinja templates in
// docs/overrides/, the only HTML in this repo.
{
  "tagname-lowercase": true,
  "attr-lowercase": true,
  "attr-value-double-quotes": true,
  "attr-value-not-empty": false,
  "attr-no-duplication": true,
  // the templates are partials or extend the theme's base.html, which declares the doctype
  "doctype-first": false,
  "tag-pair": true,
  "tag-self-close": false,
  "spec-char-escape": true,
  "id-unique": true,
  "src-not-empty": true,
  "title-require": true,
  "alt-require": true,
  "doctype-html5": true,
  // lowercase and dashes, plus the BEM __element and --modifier separators used by the theme
  "id-class-value": {
    "regId": "^[a-z\\d]+(-[a-z\\d]+)*(__[a-z\\d]+(-[a-z\\d]+)*)?(--[a-z\\d]+(-[a-z\\d]+)*)?$",
    "message": "The id and class attribute values must be in lowercase, split by a dash, optionally with BEM __element and --modifier parts."
  },
  "style-disabled": false,
  "inline-style-disabled": false,
  "inline-script-disabled": false,
  "space-tab-mixed-disabled": "space",
  "id-class-ad-disabled": false,
  "href-abs-or-rel": false,
  "attr-unsafe-chars": true,
  "head-script-disabled": true
}
