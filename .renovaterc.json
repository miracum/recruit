{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>miracum/.github//renovate/default"],
  "ignorePaths": ["**/node_modules/**", "**/bower_components/**"],
  "pip-compile": {
    "managerFilePatterns": ["/(^|/|\\.)requirements\\.txt$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "MII Kerndatensatz FHIR packages, kept in sync between the IG's sushi-config.yaml and fhir/package.json",
      "managerFilePatterns": [
        "/^fhir/ig/sushi-config\\.yaml$/",
        "/^fhir/package\\.json$/"
      ],
      "matchStrings": [
        "\"?(?<depName>de\\.medizininformatikinitiative\\.kerndatensatz\\.[a-z0-9.-]+)\"?:\\s*\"?(?<currentValue>\\d[^\"\\s]*)\"?"
      ],
      "datasourceTemplate": "npm",
      "registryUrlTemplate": "https://packages.fhir.org"
    }
  ],
  "packageRules": [
    {
      "pinDigests": false,
      "matchPackageNames": ["/^ghcr.io/open-recruit/recruit/"]
    },
    {
      "description": "FHIR packages aren't on npmjs - fhir/package.json is only updated by the regex manager above",
      "matchManagers": ["npm"],
      "matchFileNames": ["fhir/**"],
      "enabled": false
    }
  ]
}
