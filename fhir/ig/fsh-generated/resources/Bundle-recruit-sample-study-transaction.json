    {
      "resource": {
        "resourceType": "Library",
        "id": "bb4e037a-0a43-4fee-befc-b9ed598c3e64",
        "status": "active",
        "name": "bronchitis",
        "identifier": [
          {
            "system": "https://openrecruit.dev/fhir/identifiers/trino-sql-criteria-library-id",
            "value": "bronchitis"
          }
        ],
        "type": {
          "coding": [
            {
              "code": "sql-query",
              "system": "https://sql-on-fhir.org/ig/CodeSystem/LibraryTypesCodes"
            }
          ]
        },
        "content": [
          {
            "contentType": "application/sql;dialect=trino",
            "extension": [
              {
                "url": "https://sql-on-fhir.org/ig/StructureDefinition/sql-text",
                "valueString": "SELECT\n    patient.id AS patient_id,\n    EXISTS (\n        SELECT 1\n        FROM\n            fhir.default.condition,\n            UNNEST(condition.code.coding) AS condition_coding\n        WHERE\n            condition.subject.reference = CONCAT('Patient/', patient.id)\n            AND condition_coding.system = 'http://snomed.info/sct'\n            AND condition_coding.code IN ('10509002')\n    ) AS is_met,\n    CAST(NULL AS BOOLEAN) AS is_indeterminate,\n    CAST(NULL AS VARCHAR) AS result_note\nFROM fhir.default.patient AS patient"
              }
            ],
            "data": ""
          },
          {
            "contentType": "application/sql;dialect=duckdb",
            "extension": [
              {
                "url": "https://sql-on-fhir.org/ig/StructureDefinition/sql-text",
                "valueString": "SELECT\n    patient.id AS patient_id,\n    EXISTS (\n        SELECT 1\n        FROM\n            fhir.default.condition,\n            UNNEST(condition.code.coding) AS u(condition_coding)\n        WHERE\n            condition.subject.reference = CONCAT('Patient/', patient.id)\n            AND condition_coding.system = 'http://snomed.info/sct'\n            AND condition_coding.code IN ('10509002')\n    ) AS is_met,\n    CAST(NULL AS BOOLEAN) AS is_indeterminate,\n    CAST(NULL AS VARCHAR) AS result_note\nFROM fhir.default.patient AS patient"
              }
            ],
            "data": ""
          }
        ],
        "title": "Bronchitis diagnosis",
        "description": "Active bronchitis diagnosis (SNOMED CT code 10509002)."
      },
      "request": {
        "method": "PUT",
        "url": "Library/bb4e037a-0a43-4fee-befc-b9ed598c3e64"
