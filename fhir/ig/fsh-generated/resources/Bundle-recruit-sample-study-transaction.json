    {
      "resource": {
        "resourceType": "Library",
        "id": "12b09320-2426-43e9-930d-64f151d39e68",
        "status": "active",
        "name": "age-over-18",
        "identifier": [
          {
            "system": "https://openrecruit.dev/fhir/identifiers/trino-sql-criteria-library-id",
            "value": "age-over-18"
          }
        ],
        "type": {
          "coding": [
            {
              "code": "sql-query",
              "system": "https://sql-on-fhir.org/ig/CodeSystem/LibraryTypesCodes"
            }
          ]
        },
        "content": [
          {
            "contentType": "application/sql;dialect=trino",
            "extension": [
              {
                "url": "https://sql-on-fhir.org/ig/StructureDefinition/sql-text",
                "valueString": "SELECT\n    patient.id AS patient_id,\n    cast(NULL AS BOOLEAN) AS is_indeterminate,\n    cast(NULL AS VARCHAR) AS result_note,\n    date_diff('year', date(patient.birthdate), current_date) > 18 AS is_met\nFROM fhir.default.patient AS patient"
              }
            ],
            "data": ""
          },
          {
            "contentType": "application/sql;dialect=duckdb",
            "extension": [
              {
                "url": "https://sql-on-fhir.org/ig/StructureDefinition/sql-text",
                "valueString": "SELECT\n    patient.id AS patient_id,\n    cast(NULL AS BOOLEAN) AS is_indeterminate,\n    cast(NULL AS VARCHAR) AS result_note,\n    date_sub('year', CAST(patient.birthdate AS DATE), current_date) > 18 AS is_met\nFROM fhir.default.patient AS patient"
              }
            ],
            "data": ""
          }
        ],
        "title": "Age over 18",
        "description": "Patient is over 18 years old."
      },
      "request": {
        "method": "PUT",
        "url": "Library/12b09320-2426-43e9-930d-64f151d39e68"
