{
  "resourceType": "Bundle",
  "id": "recruit-search-parameters-transaction",
  "type": "transaction",
  "entry": [
    {
      "resource": {
        "resourceType": "SearchParameter",
        "id": "researchstudy-enrollment",
        "url": "https://openrecruit.dev/fhir/SearchParameter/researchstudy-enrollment",
        "name": "ResearchStudyEnrollment",
        "description": "The Group resource representing the study enrollment",
        "base": [
          "ResearchStudy"
        ],
        "status": "active",
        "code": "enrollment",
        "type": "reference",
        "expression": "enrollment",
        "target": [
          "Group"
        ]
      },
      "request": {
        "method": "PUT",
        "url": "SearchParameter/researchstudy-enrollment"
      }
    },
    {
      "resource": {
        "resourceType": "SearchParameter",
        "id": "group-characteristic",
        "url": "https://openrecruit.dev/fhir/SearchParameter/group-characteristic",
        "name": "GroupCharacteristic",
        "description": "An entity referenced in a characteristic",
        "base": [
          "Group"
        ],
        "status": "active",
        "code": "characteristic",
        "type": "reference",
        "expression": "characteristic.value.ofType(Reference)"
      },
      "request": {
        "method": "PUT",
        "url": "SearchParameter/group-characteristic"
      }
    },
    {
      "resource": {
        "resourceType": "SearchParameter",
        "id": "belongs-to-study",
        "url": "https://openrecruit.dev/fhir/SearchParameter/belongs-to-study",
        "name": "BelongsToStudy",
        "description": "The ResearchStudy a List or MeasureReport pertains to",
        "base": [
          "List",
          "MeasureReport"
        ],
        "status": "active",
        "code": "belongs-to-study",
        "type": "reference",
        "expression": "extension('https://openrecruit.dev/fhir/StructureDefinition/belongs-to-study').value.ofType(Reference)",
        "target": [
          "ResearchStudy"
        ]
      },
      "request": {
        "method": "PUT",
        "url": "SearchParameter/belongs-to-study"
      }
    },
    {
      "resource": {
        "resourceType": "SearchParameter",
        "id": "observation-derived-from-library",
        "url": "https://openrecruit.dev/fhir/SearchParameter/observation-derived-from-library",
        "name": "ObservationDerivedFromLibrary",
        "description": "The Library resource containing the eligibility criterion this Observation was derived from",
        "base": [
          "Observation"
        ],
        "status": "active",
        "code": "derived-from-library",
        "type": "reference",
        "expression": "extension('https://openrecruit.dev/fhir/StructureDefinition/eligibility-assessment-derived-from-library').value.ofType(Reference)",
        "target": [
          "Library"
        ]
      },
      "request": {
        "method": "PUT",
        "url": "SearchParameter/observation-derived-from-library"
      }
    }
  ]
}
